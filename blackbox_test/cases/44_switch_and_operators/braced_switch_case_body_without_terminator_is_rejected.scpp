// PR #414: wrapping a case body in braces does not by itself satisfy the "no
// implicit fallthrough" rule -- the block's own last statement must still be
// `break;`/`return ...;`/`continue;`.
int main() {
    switch (1) {
        case 1: {
            int value = 0;
            value = value + 1;
        }
        default:
            return 1;
    }
}
