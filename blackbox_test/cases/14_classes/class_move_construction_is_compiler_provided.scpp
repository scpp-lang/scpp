// book ch05-01/spec §6.4: every class gets a compiler-synthesized move
// constructor unconditionally -- even `Counter`, which (having a
// user-declared destructor and no copy constructor/assignment of its
// own) is *not* copy-eligible at all (spec §6.5). Move and copy are
// independent tracks: `Counter y(std::move(x));` still works here.
class Counter {
private:
    int value{};
public:
    Counter(int start) {
        this->value = start;
        return;
    }
    virtual ~Counter() {
        return;
    }
    int get() const {
        return this->value;
    }
};

int main() {
    Counter x{5};
    Counter y{std::move(x)};
    return y.get();
}
