// PR #414: the case-terminator check stays purely syntactic. A trailing
// `if`/`else` whose branches all return does terminate the case in practice,
// but proving that needs flow analysis the check deliberately does not do,
// so it is still rejected.
int main() {
    int flag = 1;
    switch (1) {
        case 1: {
            if (flag == 1) {
                return 0;
            } else {
                return 2;
            }
        }
        default:
            return 1;
    }
}
