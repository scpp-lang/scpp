// `r.a` and `s.a` are the same place; the reference binding is
// canonicalized away before the state is recorded, so moving through
// `r` marks `s.a`, not `r`.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { std::print("~R{}\n", this.id); }
};

R make_r(int i) { R r{i}; return r; }

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    S s{1, 2};
    S& r = s;
    R t = std::move(r.a);
    std::print("t={}\n", t.id);
    return 0;
}
