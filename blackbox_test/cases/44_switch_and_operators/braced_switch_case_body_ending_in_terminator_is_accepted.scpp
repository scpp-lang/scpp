// PR #414 (refines PR #336): a `case` whose body is a braced block is
// accepted when that block's own last statement is an explicit terminator
// -- the "no implicit fallthrough" rule is about ending a case explicitly,
// which a braced body ending in `break;`/`return ...;`/`continue;` does.
// Braces also give each case its own scope, so sibling cases may reuse a
// local's name.
int main() {
    int total = 0;
    for (int i = 0; i < 4; i = i + 1) {
        switch (i) {
            case 0: {
                int step = 1;
                total = total + step;
                break;
            }
            case 1: {
                int step = 10;
                total = total + step;
                continue;
            }
            default: {
                int step = 100;
                total = total + step;
                break;
            }
        }
        total = total + 1000;
    }
    // i=0: +1   then +1000 -> 1001
    // i=1: +10  then continue skips the +1000 -> 1011
    // i=2: +100 then +1000 -> 2111
    // i=3: +100 then +1000 -> 3211
    return total - 3211;
}
