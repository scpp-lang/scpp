// The accepting side of spec §11.2(5): a pointer or reference to an
// interface is explicitly still well-formed, and an ordinary call in any
// of the newly checked positions must stay accepted.
class [[scpp::interface]] IValue {
public:
    virtual ~IValue() = default;
    virtual int value() {
        return 1;
    }
};

class Impl : public virtual IValue {
public:
    ~Impl() override = default;

    int value() override {
        return 5;
    }
};

int peek(int v) {
    return v;
}

// A pointer to an interface is not an object of interface type, so the
// namespace-scope rule must leave it alone (spec §11.2(5) note: "Passing
// or returning an interface by reference or pointer remains well-formed").
Impl object;
IValue* g = &object;

int main() {
    if (g) {
        return 0;
    }
    return 1;
}
