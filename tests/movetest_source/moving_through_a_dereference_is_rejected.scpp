import std;

struct R {
    int id = 0;
    R(int i) : id{i} {}
    ~R() {}
};

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

struct Inner {
    R q;
    Inner(int x) : q{x} {}
};

struct Outer {
    Inner i;
    R z;
    Outer(int x, int y) : i{x}, z{y} {}
};

R make_r(int i) { R r{i}; return r; }

int caller() {
    R x{1};
    R* p = &x;
    R t = std::move(*p);
    return t.id;
}
