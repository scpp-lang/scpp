// #459's rule -- "is this expression a value?" -- applied to the result
// of a `void` conditional. The conditional being legal as a *discarded*
// expression must not make it legal as a value: binding it to a variable
// requires a value, and a `void` expression produces none.
int taken = 0;

void h() { taken = 1; }
void h2() { taken = 2; }

int main() {
    bool c = true;
    int x = c ? h() : h2();
    return x;
}
