// The tightened place check must not reject a write whose types already
// agree, at any place shape, nor an explicit cast that spells the
// conversion out.
struct S { uint8_t u; };
int f() {
    S s{};
    uint8_t v = 1;
    s.u = v;
    int8_t a = 1;
    s.u = static_cast<uint8_t>(a);
    int arr[2];
    int i = 1;
    arr[0] = i;
    arr[1] = static_cast<int>(v);
    if (s.u == 1) { return 1; }
    return 0;
}
