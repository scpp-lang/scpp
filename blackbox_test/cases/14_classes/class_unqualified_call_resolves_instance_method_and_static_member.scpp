// PR #391 / spec §6.2(8) "Methods and `this`": inside a method, an
// unqualified call first resolves to the enclosing class's own instance
// method (as if spelled `this->m(...)`) or its own `static` member (as
// if spelled `ClassName::m(...)`) -- real C++'s own unqualified-lookup
// rule, which scpp previously rejected outright as "call to unknown
// function".
class Calculator {
public:
    static int unit() {
        return 1;
    }
    int helper() const {
        return 6;
    }
    int compute() const {
        return helper() + unit();
    }
    virtual ~Calculator() = default;
};

int main() {
    Calculator calc{};
    return calc.compute() - 7;
}
