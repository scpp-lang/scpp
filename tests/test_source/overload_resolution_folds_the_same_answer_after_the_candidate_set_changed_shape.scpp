// The constant evaluator's candidate sets were `std::vector<const
// Function*>` into `Program::functions`, while the index that produced
// them (`functions_by_name_`) and the answer they produced
// (`OptionalFunctionRef`) were both already index/reference based. Only
// the layer in between held raw pointers, and every dereference of one
// is a gated operation (spec §5.1(5.1), §7.1(4)) -- which is why the
// self-hosting probe stopped inside this file's own ambiguity message.
//
// The candidate set is now the same indices `functions_by_name_` hands
// out. `Program::functions` is never mutated during evaluation, so an
// index and a pointer name the same element -- but "behaviour
// preserving" has to be observed, not asserted: every selection rule the
// layer implements is exercised here and printed, folded, beside the
// run-time answer for the identical call.
import std;

// [over.match.best]/2.4: a non-template is better than a template.
constexpr int pick(int v) { return v + 1; }
template<typename T>
constexpr int pick(T v) { return v + 100; }

// [over.ics.rank]: `f(int&)` and `f(const int&)` both bind an lvalue,
// and the less-qualified one wins. Selecting the first declared instead
// would answer 20.
constexpr int rank(int& v) { return 10; }
constexpr int rank(const int& v) { return 20; }

// [basic.def]/1: a declaration and the definition it belongs to are one
// function, so the bodyless declaration is not a second candidate and
// this is not ambiguous.
constexpr int declared_once(int v);
constexpr int declared_once(int v) { return v + 5; }

constexpr int folded_pick() { return pick(1); }
constexpr int folded_rank() { int v = 0; return rank(v); }
constexpr int folded_declared_once() { return declared_once(1); }

int main() {
    constexpr int folded_pick_answer = folded_pick();
    constexpr int folded_rank_answer = folded_rank();
    constexpr int folded_declared_answer = folded_declared_once();
    int runtime_v = 0;
    std::print("pick {} {}\n", folded_pick_answer, pick(1));
    std::print("rank {} {}\n", folded_rank_answer, rank(runtime_v));
    std::print("declared {} {}\n", folded_declared_answer, declared_once(1));
    return 0;
}
