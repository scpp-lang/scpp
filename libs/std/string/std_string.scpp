// std_string.scpp
//
// The `:string` interface partition (ch11 §11.4) of the "std" module:
// `namespace std { export class string { ... }; }`, a thin wrapper
// around the extern "C" functions declared below, which are themselves
// a plain-C-ABI shim over real C++ `std::string` (see
// scpp_string_wrapper.h/.cpp, built by the manifest's custom object step --
// libs/README.md explains the full build story). Every
// method's body is `[[scpp::unsafe]] { <one extern "C" call> }`, exactly like any
// other call to an `extern "C"` function (ch01 §1.3/ch02). std.scpp (the
// module's primary interface unit) aggregates this partition via
// `export import :string;`, so a consumer never imports this file
// directly -- only `import std;`, then `std::string`.
export module std:string;

// The extern "C" wrapper functions stay at file scope, *outside*
// `namespace std` -- they're plain C symbols (real C linkage, never
// namespace-qualified or mangled regardless of enclosing namespace, ch02
// §2.1/ch11 §11.10) and are not `export`-marked, so they're entirely
// invisible to anything that imports this partition or the module as a
// whole: only `std::string` itself is part of the public surface.
extern "C" {
    void* scpp_string_new(const char* s);
    void* scpp_string_new_sized(const char* s, size_t n);
    void* scpp_string_copy(const void* handle);
    void scpp_string_delete(void* handle);
    size_t scpp_string_length(void* handle);
    void scpp_string_reserve(void* handle, size_t n);
    const char* scpp_string_c_str(void* handle);
    void scpp_string_append(void* handle, const char* s);
    void scpp_string_push_back(void* handle, char c);
    int scpp_string_equals(void* handle, const char* s);
    const char* scpp_int64_to_cstr(int64_t value);
    const char* scpp_uint64_to_cstr(size_t value);
    int scpp_string_contains(void* handle, const char* needle);
    size_t scpp_string_find(void* handle, const char* needle, size_t start);
    size_t scpp_string_find_char(void* handle, char needle, size_t start);
    size_t scpp_string_rfind(void* handle, const char* needle);
    size_t scpp_string_rfind_char(void* handle, char needle);
    int scpp_string_ends_with(void* handle, const char* suffix);
    const char* scpp_string_substr(void* handle, size_t pos, size_t len);
}

namespace std {

// std::string::npos's equivalent: scpp doesn't yet support static data
// members (see std::string_view's own identical
// __string_view_not_found workaround in std_string_view.scpp, for the
// same underlying gap), so find()/rfind() callers compare against this
// free function's result instead of a true `std::string::npos` constant.
[[nodiscard]] size_t __string_not_found() {
    return static_cast<size_t>(-1);
}

export class string {
private:
    // Opaque handle onto the real std::string heap-allocated on
    // string's behalf by scpp_string_new -- scpp itself never sees
    // `std::string`, only this untyped handle (ch04 §4.2: a member
    // variable is never public, so this representation detail can never
    // leak to callers even accidentally).
    void* handle{};

public:
    string() {
        [[scpp::unsafe]] {
            this->handle = scpp_string_new("");
        }
        return;
    }

    string(const char* s) {
        [[scpp::unsafe]] {
            this->handle = scpp_string_new(s);
        }
        return;
    }

    string(const char* s, size_t n) {
        [[scpp::unsafe]] {
            this->handle = scpp_string_new_sized(s, n);
        }
        return;
    }

    string(const string& other) {
        [[scpp::unsafe]] {
            this->handle = scpp_string_copy(other.handle);
        }
        return;
    }

    string& operator=(const string& other) {
        [[scpp::unsafe]] {
            void* copied = scpp_string_copy(other.handle);
            scpp_string_delete(this->handle);
            this->handle = copied;
        }
        return *this;
    }

    virtual ~string() {
        [[scpp::unsafe]] {
            scpp_string_delete(this->handle);
        }
        return;
    }

    // Number of bytes currently stored (std::string::size()/length()).
    size_t length() const {
        [[scpp::unsafe]] {
            return scpp_string_length(this->handle);
        }
    }

    size_t size() const {
        return this->length();
    }

    // std::string::reserve(n): a pure capacity hint with no observable
    // effect on this string's own content/length (forwarded directly to
    // real std::string::reserve via the C-ABI wrapper).
    void reserve(size_t n) {
        [[scpp::unsafe]] {
            scpp_string_reserve(this->handle, n);
        }
        return;
    }

    // std::string::empty(): true when no bytes are currently stored.
    bool empty() const {
        return this->length() == 0;
    }

    // The string's content as a nul-terminated C string, e.g. to hand to
    // another extern "C" function like puts(). Valid only until the next
    // call to append() on this same string (matches
    // std::string::c_str()'s own invalidation rule -- see
    // scpp_string_wrapper.h).
    const char* c_str() const {
        [[scpp::unsafe]] {
            return scpp_string_c_str(this->handle);
        }
    }

    // [string.access]: the checked element accessor, calling std::abort()
    // where real C++ throws std::out_of_range -- matching
    // std::string_view::at and std::vector::at in this same library.
    // It returns `const char&` only: this class hands out its bytes
    // through the C wrapper's `c_str()`, whose buffer is invalidated by
    // the next append(), so a mutable reference into it would be a handle
    // SCPP26 cannot check -- which is why `operator[]` below is also
    // const-only rather than the two overloads real std::string has.
    const char& at(size_t index) const {
        if (index >= this->length()) std::abort();
        [[scpp::unsafe]] {
            return this->c_str()[index];
        }
    }

    // [string.access]: `s[i]` is the unchecked spelling in C++; here it
    // is the same checked access `at` performs, for the same
    // buffer-lifetime reason given above.
    const char& operator[](size_t index) const {
        return this->at(index);
    }

    // std::string::clear(): empties this string's content in place,
    // reusing the existing new/delete C-wrapper pair rather than adding a
    // new one -- equivalent to `*this = string()` but without going
    // through operator=/a temporary.
    void clear() {
        [[scpp::unsafe]] {
            scpp_string_delete(this->handle);
            this->handle = scpp_string_new("");
        }
        return;
    }

    // Appends `s` to this string's content in place.
    void append(const char* s) {
        [[scpp::unsafe]] {
            scpp_string_append(this->handle, s);
        }
        return;
    }

    // std::string::push_back(c): appends a single character to this
    // string's content in place.
    void push_back(char c) {
        [[scpp::unsafe]] {
            scpp_string_push_back(this->handle, c);
        }
        return;
    }

    void append(const string& s) {
        this->append(s.c_str());
        return;
    }

    // [string.op.append]: `s += x`. These are the operator functions the
    // language selects for `+=` on a std::string; before they existed,
    // codegen carried a hard-coded rewrite of `std::string += ...` into
    // `.append(...)`, which is the shape of compensation this library
    // declaration replaces.
    string& operator+=(const char* s) {
        this->append(s);
        return *this;
    }

    string& operator+=(const string& s) {
        this->append(s.c_str());
        return *this;
    }

    string& operator+=(char c) {
        this->push_back(c);
        return *this;
    }

    // [string.op.plus]: `s + x` yields a new string, leaving both
    // operands untouched.
    string operator+(const char* s) const {
        string result{this->c_str()};
        result.append(s);
        return result;
    }

    string operator+(const string& s) const {
        string result{this->c_str()};
        result.append(s.c_str());
        return result;
    }

    string operator+(char c) const {
        string result{this->c_str()};
        result.push_back(c);
        return result;
    }

    // True if this string's content equals `s` byte-for-byte.
    bool equals(const char* s) const {
        [[scpp::unsafe]] {
            return scpp_string_equals(this->handle, s) != 0;
        }
    }

    bool operator==(const char* other) const {
        return this->equals(other);
    }

    bool operator!=(const char* other) const {
        return !this->equals(other);
    }

    bool operator==(const string& other) const {
        return this->equals(other.c_str());
    }

    bool operator!=(const string& other) const {
        return !this->equals(other.c_str());
    }

    // std::string::contains(std::string_view) (C++23): true if `s`
    // occurs anywhere within this string's content.
    bool contains(const char* s) const {
        [[scpp::unsafe]] {
            return scpp_string_contains(this->handle, s) != 0;
        }
    }

    bool contains(const string& s) const {
        return this->contains(s.c_str());
    }

    // std::string::find: byte offset of the first occurrence of the
    // needle at or after `start`, or std::__string_not_found() if
    // absent (this codebase's stand-in for std::string::npos -- see
    // that function's own comment above).
    size_t find(const char* needle, size_t start) const {
        [[scpp::unsafe]] {
            return scpp_string_find(this->handle, needle, start);
        }
    }

    size_t find(const char* needle) const {
        return this->find(needle, static_cast<size_t>(0));
    }

    size_t find(char needle, size_t start) const {
        [[scpp::unsafe]] {
            return scpp_string_find_char(this->handle, needle, start);
        }
    }

    size_t find(char needle) const {
        return this->find(needle, static_cast<size_t>(0));
    }

    // std::string::rfind: byte offset of the LAST occurrence of the
    // needle (searching backward from the end), or
    // std::__string_not_found() if absent.
    size_t rfind(const char* needle) const {
        [[scpp::unsafe]] {
            return scpp_string_rfind(this->handle, needle);
        }
    }

    size_t rfind(char needle) const {
        [[scpp::unsafe]] {
            return scpp_string_rfind_char(this->handle, needle);
        }
    }

    // std::string::ends_with (C++20): true if `suffix` is a suffix of
    // this string's content.
    bool ends_with(const char* suffix) const {
        [[scpp::unsafe]] {
            return scpp_string_ends_with(this->handle, suffix) != 0;
        }
    }

    bool ends_with(const string& suffix) const {
        return this->ends_with(suffix.c_str());
    }

    // std::string::substr: a fresh string holding `len` bytes starting
    // at byte offset `pos` (clamped to however many bytes are actually
    // available, same as real std::string::substr).
    string substr(size_t pos, size_t len) const {
        const char* text = "";
        [[scpp::unsafe]] {
            text = scpp_string_substr(this->handle, pos, len);
        }
        return string(text);
    }

    string substr(size_t pos) const {
        return this->substr(pos, this->length());
    }
};

// [string.op.plus]/1: `"literal" + s`. A non-member operator function,
// because the left operand is not a std::string and so has no member
// operator to find. It is reached from outside namespace std by
// [basic.lookup.argdep]: std::string's namespace is associated with the
// call.
export string operator+(const char* lhs, const string& rhs) {
    string result{lhs};
    result.append(rhs.c_str());
    return result;
}

export string operator+(char lhs, const string& rhs) {
    string result{""};
    result.push_back(lhs);
    result.append(rhs.c_str());
    return result;
}

// std::to_string(std::int64_t)/std::to_string(std::size_t): formats an
// integer value as a decimal std::string, mirroring real C++'s
// std::to_string. Only these two overloads exist here (not the full
// set of built-in-numeric-type overloads real std::to_string provides)
// since these are the only argument types actually used by scpp's own
// self-hosting sources today -- add more overloads if/when another
// integer type needs converting.
export string to_string(int64_t value) {
    const char* text = "";
    [[scpp::unsafe]] {
        text = scpp_int64_to_cstr(value);
    }
    return string(text);
}

export string to_string(size_t value) {
    const char* text = "";
    [[scpp::unsafe]] {
        text = scpp_uint64_to_cstr(value);
    }
    return string(text);
}

} // namespace std
