// PR #414: the rule asks whether the braced body's last *statement* terminates
// the case, not whether a `break;` appears somewhere inside it. A trailing loop
// containing a `break;` does not terminate the case -- that `break;` leaves the
// loop -- so the case still falls through implicitly and is rejected.
int main() {
    int total = 0;
    switch (1) {
        case 1: {
            while (total < 3) {
                total = total + 1;
                break;
            }
        }
        default:
            return 1;
    }
    return total;
}
