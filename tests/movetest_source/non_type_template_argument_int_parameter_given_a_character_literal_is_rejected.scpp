// [temp.arg.nontype]/2 makes a non-type template argument a converted
// constant expression *of the parameter's type*, and `docs/spec/` adopts
// no clause about template arguments, so front-matter §1(2) applies that
// rule unchanged. Which type that is, is then spec §16.2/§16.3's
// question: §16.2(4) gives a character-literal type `char` outright, and
// §16.3(1) has no implicit conversion from it to `int`. It used to be
// accepted, binding N to 65.
template<int N>
class FixedValue {
public:
    virtual ~FixedValue() { return; }
    int get_n() { return N; }
};

int main() {
    FixedValue<'A'> v{};
    return v.get_n();
}
