// spec §5.1(5.1) with §5.1(6), restated for `*E` by §7.1(4): indirection
// through a value of pointer type is a gated operation, ill-formed in a
// safe context. Every spelling that produces one -- `*p`, `p->x`, a
// pointer reached through a reference to it, and a pointer *member* --
// is the same operation and must be gated the same way. The `[[scpp::
// unsafe]]` sibling case is the acceptance control.
import std;

class Node {
public:
    int v;
    Node(int n) : v{n} {}
    virtual ~Node() {}
};

struct Holder {
    Node* p;
};

int main() {
    Node n{7};
    Node* raw{};
    Holder h{};
    [[scpp::unsafe]] {
        raw = &n;
        h.p = &n;
    }
    int total = (*raw).v + raw->v + h.p->v;
    Node*& through_reference = raw;
    total = total + (*through_reference).v;
    return total - 28;
}
