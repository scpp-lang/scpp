// A literal subscript names a place just as a member does.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { std::print("~R{}\n", this.id); }
};

R make_r(int i) { R r{i}; return r; }

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    R arr[2];
    arr[0] = make_r(1);
    arr[1] = make_r(2);
    R t = std::move(arr[0]);
    std::print("t={}\n", t.id);
    return 0;
}
