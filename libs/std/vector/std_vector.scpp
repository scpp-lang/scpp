export module std:vector;

import :cstdlib;
import :concepts;

extern "C" {
    void* scpp_vector_allocate(uint64_t bytes, uint64_t align);
    void scpp_vector_deallocate(void* ptr, uint64_t align);
    void scpp_vector_relocate_bytes(void* dst, void* src, uint64_t bytes);
}

namespace std {

void* __vector_allocate(uint64_t bytes, uint64_t align) {
    [[scpp::unsafe]] {
        return scpp_vector_allocate(bytes, align);
    }
}

void __vector_deallocate(void* ptr, uint64_t align) {
    [[scpp::unsafe]] {
        scpp_vector_deallocate(ptr, align);
    }
    return;
}

void __vector_relocate_bytes(void* dst, void* src, uint64_t bytes) {
    [[scpp::unsafe]] {
        scpp_vector_relocate_bytes(dst, src, bytes);
    }
    return;
}

export template<typename T>
class [[scpp::thread_movable_if(scpp::is_thread_movable(T), scpp::is_thread_shareable(T))]] vector {
private:
    T* data_{};
    size_t size_{};
    size_t capacity_{};
    uint64_t elem_size_{static_cast<uint64_t>(sizeof(T))};
    uint64_t elem_align_{static_cast<uint64_t>(alignof(T))};

    void __check_index(size_t index) const {
        if (index >= this->size_) {
            std::abort();
        }
        return;
    }

    T* __allocate_for(size_t capacity) {
        T* empty{};
        if (capacity <= 0) return empty;
        [[scpp::unsafe]] {
            return static_cast<T*>(std::__vector_allocate(static_cast<uint64_t>(capacity) * this->elem_size_,
                                                          this->elem_align_));
        }
    }

    void __destroy_live_elements() {
        size_t i = this->size_;
        while (i > 0) {
            i = i - 1;
            [[scpp::unsafe]] {
                T* slot = &this->data_[i];
                slot->~T();
            }
        }
        this->size_ = 0;
        return;
    }

    void __deallocate_storage() {
        T* empty{};
        if (this->data_ != empty) {
            [[scpp::unsafe]] {
                std::__vector_deallocate(static_cast<void*>(this->data_), this->elem_align_);
            }
        }
        this->data_ = empty;
        this->capacity_ = 0;
        return;
    }

    void __grow_to(size_t new_capacity) {
        T* fresh = this->__allocate_for(new_capacity);
        T* old_data = this->data_;
        if (this->size_ > 0) {
            uint64_t bytes = static_cast<uint64_t>(this->size_) * this->elem_size_;
            [[scpp::unsafe]] {
                std::__vector_relocate_bytes(static_cast<void*>(fresh), static_cast<void*>(old_data), bytes);
            }
        }
        T* empty{};
        this->data_ = fresh;
        this->capacity_ = new_capacity;
        if (old_data != empty) {
            [[scpp::unsafe]] {
                std::__vector_deallocate(static_cast<void*>(old_data), this->elem_align_);
            }
        }
        return;
    }

    void __ensure_capacity_for_one_more() {
        if (this->size_ < this->capacity_) return;
        size_t next_capacity = this->capacity_ == 0 ? static_cast<size_t>(1) : this->capacity_ * 2;
        this->__grow_to(next_capacity);
        return;
    }

    // Opens `count` uninitialized slots at `offset`, growing first if
    // the result would not fit. [vector.modifiers]/2: "Causes
    // reallocation if the new size is greater than the old capacity" --
    // and reallocation is why every insert below records its position as
    // an *offset* before doing anything, since the same paragraph says
    // reallocation "invalidates all the references, pointers, and
    // iterators referring to the elements in the sequence".
    //
    // The tail moves element by element, from the back, rather than
    // through __vector_relocate_bytes: that primitive memsets its source
    // after copying, which is right for a whole-buffer move (__grow_to's
    // use) and wrong for a shift, where source and destination overlap
    // and the zeroing would erase what was just written.
    void __open_slots_at(size_t offset, size_t count) {
        if (count == 0) return;
        if (this->size_ + count > this->capacity_) {
            size_t next_capacity = this->capacity_ == 0 ? count : this->capacity_;
            while (next_capacity < this->size_ + count) {
                next_capacity = next_capacity * 2;
            }
            this->__grow_to(next_capacity);
        }
        size_t scan = this->size_;
        while (scan > offset) {
            size_t source_index = scan - 1;
            [[scpp::unsafe]] {
                T* source_slot = &this->data_[source_index];
                T& moving = source_slot[0];
                new (&this->data_[source_index + count]) T(std::move(moving));
                source_slot->~T();
            }
            scan = scan - 1;
        }
        return;
    }

    size_t __offset_of(T* position) const {
        T* base = this->data_;
        [[scpp::unsafe]] {
            return static_cast<size_t>(position - base);
        }
    }

    T* __copy_data_from(const std::vector<T>& other) requires std::copy_constructible<T> {
        size_t other_size = other.size();
        T* fresh = this->__allocate_for(other_size);
        size_t i = 0;
        while (i < other_size) {
            [[scpp::unsafe]] {
                new (&fresh[i]) T(other.at(i));
            }
            i = i + 1;
        }
        return fresh;
    }

public:
    vector() { return; }

    vector(const std::vector<T>& other) requires std::copy_constructible<T> {
        this->data_ = this->__copy_data_from(other);
        this->size_ = other.size();
        this->capacity_ = other.size();
        return;
    }

    void operator=(const std::vector<T>& other) requires std::copy_constructible<T> {
        T* copied = this->__copy_data_from(other);
        this->__destroy_live_elements();
        this->__deallocate_storage();
        this->data_ = copied;
        this->size_ = other.size();
        this->capacity_ = other.size();
        return;
    }

    virtual ~vector() {
        this->__destroy_live_elements();
        this->__deallocate_storage();
        return;
    }

    void push_back(const T& value) requires std::copy_constructible<T> {
        this->__ensure_capacity_for_one_more();
        [[scpp::unsafe]] {
            new (&this->data_[this->size_]) T(value);
        }
        this->size_ = this->size_ + 1;
        return;
    }

    void push_back(T&& value) {
        this->__ensure_capacity_for_one_more();
        [[scpp::unsafe]] {
            new (&this->data_[this->size_]) T(std::move(value));
        }
        this->size_ = this->size_ + 1;
        return;
    }

    // std::vector::emplace_back() -- 0-arg form only, the sole shape
    // scpp's self-hosting sources use so far: default-constructs a new
    // trailing element in place, avoiding the extra move/copy a
    // push_back(T{}) call would need. Unconstrained, like the real one:
    // `T()` makes this ill-formed for a `T` with no default constructor
    // only if the member is actually used, which is what [temp.inst]/4
    // says and what the compiler now does. It carried a
    // `requires std::default_initializable<T>` clause purely because
    // every member definition used to be instantiated for every
    // std::vector<T> whether or not it was ever called, so an
    // unconstrained body rejected any T without a default constructor.
    void emplace_back() {
        this->__ensure_capacity_for_one_more();
        [[scpp::unsafe]] {
            new (&this->data_[this->size_]) T();
        }
        this->size_ = this->size_ + 1;
        return;
    }

    void pop_back() {
        if (this->size_ == 0) {
            std::abort();
        }
        this->size_ = this->size_ - 1;
        [[scpp::unsafe]] {
            T* slot = &this->data_[this->size_];
            slot->~T();
        }
        return;
    }

    // [vector.modifiers]: `template<class InputIterator> constexpr
    // iterator insert(const_iterator position, InputIterator first,
    // InputIterator last)`, returning "an iterator that points to the
    // first of the newly inserted elements" and, per /1, doing at most
    // one reallocation. This container had no `insert` at all -- nor any
    // `erase` -- which is what
    // `fields.insert(fields.end(), base.begin(), base.end())` in
    // src/compiler/constexpression.cppm ran into.
    template<typename InputIterator>
    T* insert(T* position, InputIterator first, InputIterator last) requires std::copy_constructible<T> {
        size_t offset = this->__offset_of(position);
        size_t count = 0;
        InputIterator counting = first;
        while (counting != last) {
            count = count + 1;
            [[scpp::unsafe]] {
                counting = counting + 1;
            }
        }
        this->__open_slots_at(offset, count);
        size_t placed = 0;
        InputIterator source = first;
        while (placed < count) {
            [[scpp::unsafe]] {
                new (&this->data_[offset + placed]) T(source[0]);
                source = source + 1;
            }
            placed = placed + 1;
        }
        this->size_ = this->size_ + count;
        [[scpp::unsafe]] {
            return &this->data_[offset];
        }
    }

    // The single-element forms, `insert(const_iterator, const T&)` and
    // `insert(const_iterator, T&&)`.
    T* insert(T* position, const T& value) requires std::copy_constructible<T> {
        size_t offset = this->__offset_of(position);
        this->__open_slots_at(offset, static_cast<size_t>(1));
        [[scpp::unsafe]] {
            new (&this->data_[offset]) T(value);
        }
        this->size_ = this->size_ + 1;
        [[scpp::unsafe]] {
            return &this->data_[offset];
        }
    }

    T* insert(T* position, T&& value) {
        size_t offset = this->__offset_of(position);
        this->__open_slots_at(offset, static_cast<size_t>(1));
        [[scpp::unsafe]] {
            new (&this->data_[offset]) T(std::move(value));
        }
        this->size_ = this->size_ + 1;
        [[scpp::unsafe]] {
            return &this->data_[offset];
        }
    }

    // `insert(const_iterator position, size_type n, const T& x)`.
    T* insert(T* position, size_t count, const T& value) requires std::copy_constructible<T> {
        size_t offset = this->__offset_of(position);
        this->__open_slots_at(offset, count);
        size_t placed = 0;
        while (placed < count) {
            [[scpp::unsafe]] {
                new (&this->data_[offset + placed]) T(value);
            }
            placed = placed + 1;
        }
        this->size_ = this->size_ + count;
        [[scpp::unsafe]] {
            return &this->data_[offset];
        }
    }

    // [vector.modifiers]/4-6: `erase(const_iterator first, const_iterator
    // last)` destroys the erased elements and moves the tail down --
    // "the destructor of T is called the number of times equal to the
    // number of the elements erased" -- returning an iterator to the
    // element that followed the last erased one.
    T* erase(T* first, T* last) {
        size_t start = this->__offset_of(first);
        size_t stop = this->__offset_of(last);
        if (stop <= start) {
            [[scpp::unsafe]] {
                return &this->data_[start];
            }
        }
        size_t count = stop - start;
        // The tail moves down by *assignment*, and only the elements
        // left over at the end are destroyed. [vector.modifiers]/6 is
        // exact about this: "the destructor of T is called the number of
        // times equal to the number of the elements erased, but the
        // assignment operator of T is called the number of times equal to
        // the number of elements in the vector after the erased
        // elements". Move-constructing the tail into place and destroying
        // each source instead would call the destructor once per moved
        // element too -- for {1,2,3} erasing the middle, twice where the
        // clause says once, which a `T` with a side-effecting destructor
        // can see.
        // The same buffer under two names, because §6.2 tracks a borrow
        // per *variable*: the move-assignment below needs a mutable
        // reference to the source element while writing through the
        // destination, and both reaching for one pointer is one variable
        // borrowed twice ("cannot use 'buffer' while it is mutably
        // borrowed"), exactly as reaching twice for `this->data_` is one
        // reborrow of `this` too many.
        T* source_slots{};
        T* target_slots{};
        [[scpp::unsafe]] {
            source_slots = this->data_;
            target_slots = this->data_;
        }
        size_t destination = start;
        size_t source_index = stop;
        size_t live_count = this->size_;
        while (source_index < live_count) {
            [[scpp::unsafe]] {
                T& moving = source_slots[source_index];
                target_slots[destination] = std::move(moving);
            }
            destination = destination + 1;
            source_index = source_index + 1;
        }
        while (destination < this->size_) {
            [[scpp::unsafe]] {
                T* slot = &this->data_[destination];
                slot->~T();
            }
            destination = destination + 1;
        }
        this->size_ = this->size_ - count;
        [[scpp::unsafe]] {
            return &this->data_[start];
        }
    }

    T* erase(T* position) {
        [[scpp::unsafe]] {
            return this->erase(position, position + 1);
        }
    }

    size_t size() const {
        return this->size_;
    }

    size_t capacity() const {
        return this->capacity_;
    }

    // std::vector::reserve: grows backing storage so at least
    // `new_capacity` elements fit without a further reallocation, if it
    // doesn't already -- a no-op if `new_capacity` is no bigger than the
    // current capacity (matches real std::vector::reserve, which never
    // shrinks).
    void reserve(size_t new_capacity) {
        if (new_capacity <= this->capacity_) return;
        this->__grow_to(new_capacity);
        return;
    }

    // std::vector::resize(count, value): grows or shrinks to hold
    // exactly `new_size` elements. Growing copy-constructs each new
    // element from `value` (mirrors real std::vector::resize's 2-arg
    // overload); shrinking destroys the excess trailing elements, same
    // as repeatedly calling pop_back().
    //
    // Unconstrained for the same reason emplace_back() above is: the
    // copy this performs is `push_back(const T&)`'s, whose own
    // `requires std::copy_constructible<T>` reports a non-copyable T at
    // the point this member is called ([temp.inst]/4) rather than
    // removing resize() from every std::vector<T> that never calls it.
    void resize(size_t new_size, const T& value) {
        while (this->size_ > new_size) {
            this->pop_back();
        }
        if (new_size > this->size_) {
            this->reserve(new_size);
            while (this->size_ < new_size) {
                this->push_back(value);
            }
        }
        return;
    }

    bool empty() const {
        return this->size_ == 0;
    }

    void clear() {
        this->__destroy_live_elements();
        return;
    }

    T& at(size_t index) {
        this->__check_index(index);
        [[scpp::unsafe]] {
            return this->data_[index];
        }
    }

    const T& at(size_t index) const {
        this->__check_index(index);
        [[scpp::unsafe]] {
            return this->data_[index];
        }
    }

    // size_ - 1 underflows to SIZE_MAX on an empty vector, which
    // __check_index rejects (index >= size_) the same way pop_back()
    // already aborts on empty -- so these stay consistent with this
    // class's existing empty-container handling without any extra check.
    // Mirrors at()'s own direct data_[index] access (rather than
    // delegating to at()) since the lifetime-tracking pass ties a
    // lifetime-tracked T&'s validity to a *direct* field access on
    // `this`, not to one seen only through a nested call's return value.
    T& back() {
        this->__check_index(this->size_ - 1);
        [[scpp::unsafe]] {
            return this->data_[this->size_ - 1];
        }
    }

    const T& back() const {
        this->__check_index(this->size_ - 1);
        [[scpp::unsafe]] {
            return this->data_[this->size_ - 1];
        }
    }

    T& front() {
        this->__check_index(0);
        [[scpp::unsafe]] {
            return this->data_[0];
        }
    }

    const T& front() const {
        this->__check_index(0);
        [[scpp::unsafe]] {
            return this->data_[0];
        }
    }

    T* data() {
        return this->data_;
    }

    const T* data() const {
        return this->data_;
    }

    T* begin() {
        return this->data_;
    }

    const T* begin() const {
        return this->data_;
    }

    T* end() {
        if (this->size_ == 0) return this->data_;
        [[scpp::unsafe]] {
            return this->data_ + this->size_;
        }
    }

    const T* end() const {
        if (this->size_ == 0) return this->data_;
        [[scpp::unsafe]] {
            return this->data_ + this->size_;
        }
    }
};

} // namespace std
