// spec §6.2(26): redeclarations of the same function are ill-formed if their
// lifetime-group annotations disagree after any consistent renaming.
const int& pick(
    const int& x [[scpp::lifetime(a)]],
    const int& y [[scpp::lifetime(a)]]
) [[scpp::lifetime(a)]];

const int& pick(
    const int& x [[scpp::lifetime(a)]],
    const int& y [[scpp::lifetime(b)]]
) [[scpp::lifetime(a)]] {
    return x;
}

int main() {
    int a{1};
    int b{2};
    return pick(a, b);
}
