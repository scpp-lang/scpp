import std;

// [expr.cond]/4: "if more than one conversion sequence can be formed ...
// the program is ill-formed" -- convertible in both directions is a
// rejection, not a choice between them.
class B;

class A {
  public:
    virtual ~A() = default;
    int v;
    A(int x) : v{x} { return; }
    A(const B& b);
};

class B {
  public:
    virtual ~B() = default;
    int w;
    B(int x) : w{x} { return; }
    B(const A& a) : w{a.v} { return; }
};

A::A(const B& b) : v{b.w} { return; }

int main() {
    bool c = true;
    A a{1};
    B b{2};
    return (c ? a : b).v;
}
