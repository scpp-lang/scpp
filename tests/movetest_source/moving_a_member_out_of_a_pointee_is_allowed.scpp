// ch02 6.2(3) attaches the moved-out transition to "the object designated
// by" the operand; ch03 7.3(1) says `E1->E2` is `(*E1).E2`, and 7.1(3)
// says the class-typed `*` is a call to `operator*` that "introduces no
// distinct ownership, aliasing, or lifetime rule of its own". So `u->a`
// designates an object like any other and may be moved from. The checker
// used to refuse with "cannot move from a dereference: two pointers may
// name the same object, so what '*' names cannot be identified
// statically" -- a statement about its own tracking, not about the
// program.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { return; }
};

R mk(int i) { R r{}; r.id = i; return r; }

struct S {
    R a;
    R b;
    S() : a{0}, b{0} {}
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    std::unique_ptr<S> u = std::make_unique<S>();
    u->a.id = 1;
    R t = std::move(u->a);
    return t.id;
}
