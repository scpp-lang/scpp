import std;

struct R {
    int id = 0;
    R(int i) : id{i} {}
    ~R() {}
};

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

struct Inner {
    R q;
    Inner(int x) : q{x} {}
};

struct Outer {
    Inner i;
    R z;
    Outer(int x, int y) : i{x}, z{y} {}
};

R make_r(int i) { R r{i}; return r; }

// spec §6.2(3): `std::move(E)` where E is an id-expression designating an
// object places that object in the moved-out state. `s.a` designates an
// object of member storage duration, which §6.2(1) explicitly includes.
// Nothing in §6.2 or §6.3 restricts the operand to a plain local.
void caller() {
    S s{1, 2};
    R t = std::move(s.a);
    s.a = make_r(3);
    return;
}
