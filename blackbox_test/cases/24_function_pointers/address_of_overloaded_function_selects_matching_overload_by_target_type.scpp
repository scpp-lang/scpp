// spec §5.2(4),(5): This also resolves the deferred item from the
// overload-resolution rules:
// `&overloaded_name` now picks the one overload whose type exactly
// matches the target pointer-to-function type, real C++'s own
// target-type-driven rule, reused verbatim. `describe` is overloaded
// on `int` vs `bool`; the target type `int (*)(int)` must select the
// `int` overload, never the `bool` one.
int describe(int x) {
    return 100;
}

bool describe(bool x) {
    return false;
}

int main() {
    int (*fp)(int) = &describe;
    return fp(5);
}
