// §16.2(1) lists six contexts a literal takes its type from, and (1.3)
// is "the type of the parameter it is an argument for" -- so §16.2(2)
// binds in argument position exactly as it does in an initializer.
// Guards the recurring "a pass skipping positions" shape: a check
// installed only on variable initialization would pass the two cases
// above and let this one through.
char take(char c) { return c; }
int main() {
    return take(65) == 65 ? 0 : 1;
}
