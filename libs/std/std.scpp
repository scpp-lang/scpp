// std.scpp
//
// scpp's "std" module: the primary interface unit. Concrete library
// surface area lives in dedicated interface partitions, which this file
// simply re-exports for consumers of `import std;`. The order these are
// listed in is meaningless -- `:algorithm` sits first deliberately,
// because that is the position that used to trip constructor selection's
// own dependence on hash-table enumeration order (see
// check_constructor_arguments' exact-type-match comment).
export module std;

export import :algorithm;
export import :string;
export import :string_view;
export import :cstdlib;
export import :cctype;
export import :expected;
export import :optional;
export import :functional;
export import :concepts;
export import :memory;
export import :vector;
export import :unordered_set;
export import :thread;
export import :print;
export import :random;
export import :charconv;
