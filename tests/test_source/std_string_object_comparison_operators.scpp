import std;

int main() {
    std::string left{"scpp"};
    std::string same{"scpp"};
    std::string other{"cpp"};
    print_bool(left == same);
    print_bool(left != same);
    print_bool(left == other);
    print_bool(left != other);
    print_bool(left == "scpp");
    print_bool(left != "scpp");
    return 0;
}
