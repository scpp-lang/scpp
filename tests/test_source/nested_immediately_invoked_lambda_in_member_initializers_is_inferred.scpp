// The same inference runs for every position a lambda can be written in,
// so a class default member initializer, a struct one, and a constructor's
// member-initializer list must all agree with a function body.
struct S {
    int v = [](){ return [](){ return 1; }(); }();
};
class C {
  public:
    virtual ~C() = default;
    C() : b_{[](){ return [](){ return 2; }(); }()} {}
    int a_ = [](){ return [](){ return 4; }(); }();
    int b_;
};
int main() {
    S s{};
    C c{};
    return s.v + c.a_ + c.b_;
}
