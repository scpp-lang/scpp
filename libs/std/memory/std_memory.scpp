// std_memory.scpp
//
// The `:memory` interface partition of the "std" module: `std::unique_ptr<T>`
// and `std::shared_ptr<T>` wrappers consumed via
// `import std;` through std.scpp's `export import :memory;` aggregation,
// exactly like std::string's own `:string` partition.
export module std:memory;

extern "C" {
    void* scpp_shared_ptr_count_new();
    void scpp_shared_ptr_count_acquire(void* handle);
    int scpp_shared_ptr_count_release(void* handle);
    int scpp_shared_ptr_count_use_count(const void* handle);
}

namespace std {

void* __shared_ptr_count_new() {
    [[scpp::unsafe]] {
        return scpp_shared_ptr_count_new();
    }
}

void __shared_ptr_count_acquire(void* handle) {
    [[scpp::unsafe]] {
        scpp_shared_ptr_count_acquire(handle);
    }
    return;
}

bool __shared_ptr_count_release(void* handle) {
    [[scpp::unsafe]] {
        return scpp_shared_ptr_count_release(handle) != 0;
    }
}

int __shared_ptr_count_use_count(const void* handle) {
    [[scpp::unsafe]] {
        return scpp_shared_ptr_count_use_count(handle);
    }
}

export template<typename T>
class [[scpp::thread_movable_if(scpp::is_thread_movable(T), scpp::is_thread_shareable(T))]]
unique_ptr {
private:
    T* ptr_{};
    bool owns_{};

public:
    unique_ptr() {
        this->owns_ = false;
        return;
    }

    // std::unique_ptr(nullptr_t) -- real C++'s own null constructor,
    // which is what makes `std::unique_ptr<T> p = nullptr;` mean the
    // same thing as `std::unique_ptr<T> p{};`.
    unique_ptr(nullptr_t null_pointer) {
        this->owns_ = false;
        return;
    }

    unique_ptr(T* ptr) {
        this->ptr_ = ptr;
        this->owns_ = true;
        return;
    }

    virtual ~unique_ptr() {
        if (this->owns_) {
            [[scpp::unsafe]] {
                T* raw = this->ptr_;
                delete raw;
            }
        }
        return;
    }

    // [unique.ptr.single.observers]/[util.smartptr.shared.obs]: there is
    // exactly one `operator*`, and it is const-qualified returning a
    // *non-const* `T&`. A smart pointer is not `propagate_const`: the
    // handle's constness governs the handle (rebinding, reset), never the
    // pointee, which is a separate object reached through an indirection.
    // Declaring a second, const-qualified overload returning `const T&`
    // made every `const unique_ptr<T>&`/`const shared_ptr<T>&` behave as
    // `propagate_const`, which no C++ smart pointer does.
    T& operator*() const {
        [[scpp::unsafe]] {
            return *this->ptr_;
        }
    }

    T* operator->() const [[scpp::lifetime(self)]] {
        return this->ptr_;
    }

    T* get() const [[scpp::lifetime(this)]] {
        return this->ptr_;
    }

    T* release() {
        T* raw = this->ptr_;
        T* empty{};
        this->ptr_ = empty;
        this->owns_ = false;
        return raw;
    }

    bool operator==(T* other) const {
        return this->ptr_ == other;
    }

    bool operator!=(T* other) const {
        return this->ptr_ != other;
    }

    // [unique.ptr.single.observers]/5: `explicit operator bool() const
    // noexcept` -- what makes `if (p)`, `!p` and `p && q` mean "does
    // this handle own anything?". `explicit`, so `bool b = p;` stays
    // ill-formed ([over.match.copy]/1) exactly as in C++.
    explicit operator bool() const {
        return this->owns_;
    }
};

// The erased pointee is carried as `const void*`, not `void*`. A
// `shared_ptr<const std::string>` holds a `const std::string*`, and
// widening that to `void*` casts away constness -- which no cast does
// ([expr.static.cast]/11) and which SCPP26 has no `const_cast` to spell.
// Only the reference count and destruction need the erased pointer, and
// destroying a `const T` is well-formed ([expr.delete]/2), so `const
// void*` carries everything the handle actually uses. The typed pointer
// each shared_ptr<T> hands out is its own `ptr_` field, which never
// passes through the erasure and so never needs unerasing.
template<typename T>
void __shared_ptr_detail_destroy(const void* erased) {
    [[scpp::unsafe]] {
        const T* typed = static_cast<const T*>(erased);
        delete typed;
    }
    return;
}

template<typename T>
const void* __shared_ptr_detail_erase(T* ptr) {
    return static_cast<const void*>(ptr);
}

class __shared_handle {
private:
    void* control_{};
    void (*destroy_)(const void*){};

    void release_current() {
        void* empty_control{};
        if (this->control_ == empty_control) return;
        bool destroy_pointee = std::__shared_ptr_count_release(this->control_);
        void (*empty_destroy)(const void*){};
        this->control_ = empty_control;
        if (destroy_pointee && this->destroy_ != empty_destroy) {
            this->destroy_(this->ptr_);
        }
        const void* empty_ptr{};
        this->ptr_ = empty_ptr;
        this->destroy_ = empty_destroy;
        return;
    }

public:
    const void* ptr_{};

    __shared_handle() { return; }

    __shared_handle(const void* ptr, void (*destroy)(const void*)) {
        const void* empty_ptr{};
        void* empty_control{};
        this->ptr_ = ptr;
        this->destroy_ = destroy;
        if (ptr == empty_ptr) {
            this->control_ = empty_control;
        } else {
            this->control_ = std::__shared_ptr_count_new();
        }
        return;
    }

    __shared_handle(const __shared_handle& other) {
        this->ptr_ = other.ptr_;
        this->control_ = other.control_;
        this->destroy_ = other.destroy_;
        void* empty_control{};
        if (this->control_ != empty_control) std::__shared_ptr_count_acquire(this->control_);
        return;
    }

    __shared_handle shared_copy() const {
        __shared_handle copy{};
        copy.ptr_ = this->ptr_;
        copy.control_ = this->control_;
        copy.destroy_ = this->destroy_;
        void* empty_control{};
        if (copy.control_ != empty_control) std::__shared_ptr_count_acquire(copy.control_);
        return std::move(copy);
    }

    void copy_from(const __shared_handle& other) {
        void* other_control = other.control_;
        void* empty_control{};
        if (other_control != empty_control) std::__shared_ptr_count_acquire(other_control);
        this->release_current();
        this->ptr_ = other.ptr_;
        this->control_ = other_control;
        this->destroy_ = other.destroy_;
        return;
    }

    void operator=(const __shared_handle& other) {
        this->copy_from(other);
        return;
    }

    virtual ~__shared_handle() {
        this->release_current();
        return;
    }

    int use_count() const {
        void* empty_control{};
        if (this->control_ == empty_control) return 0;
        return std::__shared_ptr_count_use_count(this->control_);
    }

    void reset() {
        this->release_current();
        return;
    }

    void reset(const void* ptr, void (*destroy)(const void*)) {
        const void* empty_ptr{};
        void* empty_control{};
        this->release_current();
        this->ptr_ = ptr;
        this->destroy_ = destroy;
        if (ptr == empty_ptr) {
            this->control_ = empty_control;
        } else {
            this->control_ = std::__shared_ptr_count_new();
        }
        return;
    }
};

export template<typename T>
class [[scpp::thread_movable_if(scpp::is_thread_movable(T) && scpp::is_thread_shareable(T),
                                scpp::is_thread_movable(T) && scpp::is_thread_shareable(T))]]
shared_ptr {
private:
    T* ptr_{};
    __shared_handle handle_{};

public:
    shared_ptr() { return; }

    // std::shared_ptr(nullptr_t) -- the null constructor, exactly as in
    // real C++ (and as unique_ptr has just above): an empty shared_ptr
    // owning nothing, with no control block allocated.
    shared_ptr(nullptr_t null_pointer) { return; }

    shared_ptr(T* ptr) {
        this->ptr_ = ptr;
        this->handle_.reset(std::__shared_ptr_detail_erase<T>(ptr), std::__shared_ptr_detail_destroy<T>);
        return;
    }

    // std::shared_ptr(unique_ptr<Y>&&) (real C++'s converting-move
    // constructor): takes over sole ownership of `other`'s pointee --
    // `other` releases the raw pointer (becoming empty, exactly like
    // real C++'s own unique_ptr after this move), and this shared_ptr
    // starts a fresh reference count for it, same as the T* constructor
    // just above.
    shared_ptr(unique_ptr<T>&& other) {
        T* raw = other.release();
        this->ptr_ = raw;
        this->handle_.reset(std::__shared_ptr_detail_erase<T>(raw), std::__shared_ptr_detail_destroy<T>);
        return;
    }

    // Copying a shared_ptr is its whole point, so it is spelled out
    // explicitly: this class declares its own copy-assignment operator
    // just below, and scpp (unlike real C++, which only deprecates the
    // implicit one) then provides no implicit copy *constructor* at all.
    shared_ptr(const shared_ptr<T>& other) {
        __shared_handle copied = other.__copy_handle();
        this->handle_.copy_from(copied);
        this->ptr_ = other.get();
        return;
    }

    void operator=(const shared_ptr<T>& other) {
        // The typed pointer comes from `other.get()`, which already has
        // this specialization's own `T*` type, rather than from the
        // erased handle: the handle carries a `const void*` (widening a
        // `shared_ptr<const T>`'s pointee to `void*` would cast away
        // constness), and the reverse cast would put the constness back
        // only by laundering it.
        __shared_handle copied = other.__copy_handle();
        this->handle_.copy_from(copied);
        this->ptr_ = other.get();
        return;
    }

    virtual ~shared_ptr() {
        this->handle_.reset();
        return;
    }

    // [unique.ptr.single.observers]/[util.smartptr.shared.obs]: there is
    // exactly one `operator*`, and it is const-qualified returning a
    // *non-const* `T&`. A smart pointer is not `propagate_const`: the
    // handle's constness governs the handle (rebinding, reset), never the
    // pointee, which is a separate object reached through an indirection.
    // Declaring a second, const-qualified overload returning `const T&`
    // made every `const unique_ptr<T>&`/`const shared_ptr<T>&` behave as
    // `propagate_const`, which no C++ smart pointer does.
    T& operator*() const {
        [[scpp::unsafe]] {
            return *this->ptr_;
        }
    }

    T* operator->() const [[scpp::lifetime(self)]] {
        return this->ptr_;
    }

    T* get() const {
        return this->ptr_;
    }

    __shared_handle __copy_handle() const {
        return this->handle_.shared_copy();
    }

    int use_count() const {
        return this->handle_.use_count();
    }

    void reset() {
        T* empty_ptr{};
        this->ptr_ = empty_ptr;
        this->handle_.reset();
        return;
    }

    void reset(T* ptr) {
        this->ptr_ = ptr;
        this->handle_.reset(std::__shared_ptr_detail_erase<T>(ptr), std::__shared_ptr_detail_destroy<T>);
        return;
    }

    bool operator==(T* other) const {
        return this->ptr_ == other;
    }

    bool operator!=(T* other) const {
        return this->ptr_ != other;
    }

    // [util.smartptr.shared.obs]/8: `explicit operator bool() const
    // noexcept` is `get() != nullptr`, the same nullness test
    // `p != nullptr` already spells.
    explicit operator bool() const {
        T* empty{};
        return this->ptr_ != empty;
    }
};

export template<typename T, typename... Args>
std::unique_ptr<T> make_unique(Args... args) {
    T* raw{};
    [[scpp::unsafe]] {
        raw = new T(args...);
    }
    std::unique_ptr<T> result{raw};
    return std::move(result);
}

export template<typename T, typename... Args>
std::shared_ptr<T> make_shared(Args... args) {
    T* raw{};
    [[scpp::unsafe]] {
        raw = new T(args...);
    }
    std::shared_ptr<T> result{raw};
    return std::move(result);
}

} // namespace std
