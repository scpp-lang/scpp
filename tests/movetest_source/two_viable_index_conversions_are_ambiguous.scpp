// [over.match.best]: two conversion functions whose return types
// [expr.sub]/1 accepts equally are ambiguous, not ordered -- §16.3(1)
// provides no conversion between two scalar types to rank them by, so
// there is nothing that could make one better than the other. Selecting
// the first declared would make the element read depend on declaration
// order.
import std;

struct Idx {
    int v;
    operator int() const { return this->v; }
    operator long() const { long r = 1; return r; }
};

int main() {
    int values[3]{7, 8, 9};
    Idx idx{1};
    return values[idx] - 8;
}
