// spec §6: an untyped integer literal adopts the declared type
// directly; that is an initialization, not a conversion, so no cast is
// needed at any width or signedness.
int f() {
    int8_t a = 127;
    uint8_t b = 255;
    int16_t c = 32767;
    uint16_t d = 65535;
    int32_t e = 2147483647;
    uint32_t g = 4294967295;
    int64_t h = 9223372036854775807;
    size_t i = 18446744073709551615;
    ptrdiff_t j = 4;
    unsigned long k = 5;
    long l = 6;
    unsigned int m = 7;
    int n = 8;
    if (a == 127) { return 1; }
    if (b == 255) { return 1; }
    if (c == 32767) { return 1; }
    if (d == 65535) { return 1; }
    if (e == 2147483647) { return 1; }
    if (g == 4294967295) { return 1; }
    if (h == 9223372036854775807) { return 1; }
    if (i == 0) { return 1; }
    if (j == 4) { return 1; }
    if (k == 5) { return 1; }
    if (l == 6) { return 1; }
    if (m == 7) { return 1; }
    if (n == 8) { return 1; }
    return 0;
}
