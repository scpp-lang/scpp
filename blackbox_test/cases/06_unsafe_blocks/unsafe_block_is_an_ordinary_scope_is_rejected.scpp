// spec §5.1(1): scpp's [[scpp::unsafe]] { } is an ordinary block: it behaves
// exactly like a plain { } compound statement -- locals declared inside go out
// of scope at the closing }. Reading `local_var` after the block closes must
// be rejected, exactly as for a plain `{ }` scope.
int f() {
    [[scpp::unsafe]] {
        int local_var = 5;
    }
    return local_var;
}

int main() {
    return f();
}
