class Adder {
public:
    virtual ~Adder() { return; }

    Adder(int& value) : value{value} {
        return;
    }

    // spec §6.5(2) leaves *no* implicitly-defined copy constructor on a
    // class that declares a destructor -- and §11.5(1) makes every class
    // declare one. A reference member does not change that (§6.5(2) has
    // no reference carve-out; only §6.4(3)/§6.5(3) do, and both are about
    // assignment). So the copy construction this case is *about* has to
    // come from a copy constructor the class declares itself.
    Adder(const Adder& source) : value{source.value} {
        return;
    }

    int call(int x) const {
        return x + this->value;
    }
private:
    int& value;
};

Adder* clone(const Adder& source) {
    [[scpp::unsafe]] {
        return new Adder(source);
    }
}

int main() {
    int value = 5;
    Adder a{value};
    Adder* p = clone(a);
    int result = 0;
    [[scpp::unsafe]] {
        result = p->call(7);
        delete p;
    }
    return result - 12;
}
