// Places reached through an indirection are tracked per subobject, not
// per pointer: moving `u->a` must not poison `u->b`.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { return; }
};

R mk(int i) { R r{}; r.id = i; return r; }

struct S {
    R a;
    R b;
    S() : a{0}, b{0} {}
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    std::unique_ptr<S> u = std::make_unique<S>();
    u->a.id = 1;
    u->b.id = 2;
    R t = std::move(u->a);
    return u->b.id;
}
