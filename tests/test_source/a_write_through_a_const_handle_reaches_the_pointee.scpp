// Accept/reject is not the evidence -- what the program does is. Every
// one of these writes must land on the *same* object, reached through a
// binding whose own constness stops at the indirection.
import std;

class Cell {
public:
    virtual ~Cell() = default;
    Cell() = default;
    int v = 0;
    void set(int x) { this.v = x; return; }
    int get_v() const { return this.v; }
};

void through_shared(const std::shared_ptr<Cell>& t) {
    t->set(t->get_v() + 1);
    (*t).set((*t).get_v() + 10);
    return;
}

void through_unique(const std::unique_ptr<Cell>& t) {
    t->set(t->get_v() + 100);
    return;
}

void through_span(const std::span<int>& s) {
    s[0] = s[0] + 1000;
    return;
}

int main() {
    std::shared_ptr<Cell> p = std::make_shared<Cell>();
    through_shared(p);
    std::print("shared={}\n", p->get_v());

    std::unique_ptr<Cell> q = std::make_unique<Cell>();
    through_unique(q);
    std::print("unique={}\n", q->get_v());

    int a[2]{1, 2};
    std::span<int> view = a;
    through_span(view);
    std::print("span={} {}\n", a[0], a[1]);
    return 0;
}
