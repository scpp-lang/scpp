// PR #414: a braced case body is its own scope, so sibling cases may each
// declare a local of the same name and each case body reads back its own. Every
// arm is executed and its result checked.
//
// Scope: this asserts that each case's declaration and its own reads resolve to
// that case's local. It is deliberately not a claim that same-name locals are
// independent in every respect -- name reuse at a differing type is known to be
// tracked per-function rather than per-scope in at least one layer of the
// compiler, and that limitation is not switch-specific, so it is tracked
// separately rather than pinned here.
enum class Op { add = 1, negate = 2, scale = 3 };

int apply(Op op, int start) {
    int total = start;
    switch (op) {
        case Op::add: {
            int operand = 7;
            total = total + operand;
            break;
        }
        case Op::negate: {
            bool operand = true;
            if (operand) {
                total = 0 - total;
            }
            break;
        }
        case Op::scale: {
            char operand = 'A';
            if (operand == 'A') {
                total = total * 3;
            }
            break;
        }
        default: {
            return 0;
        }
    }
    return total;
}

int main() {
    if (apply(Op::add, 5) != 12) return 1;
    if (apply(Op::negate, 5) != 0 - 5) return 2;
    if (apply(Op::scale, 5) != 15) return 3;
    return 0;
}
