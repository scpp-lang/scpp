// A place is a root plus a path and a dereference is one more step on
// that path, so nesting composes: `(*pp)->a` is `pp` + deref + deref +
// `.a`. Nothing in ch02 6.2 or ch03 7.1 caps the depth.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { return; }
};

R mk(int i) { R r{}; r.id = i; return r; }

struct S {
    R a;
    R b;
    S() : a{0}, b{0} {}
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    S s{1, 2};
    S* p = &s;
    [[scpp::unsafe]] {
        S** pp = &p;
        R t = std::move((*pp)->a);
        return t.id;
    }
}
