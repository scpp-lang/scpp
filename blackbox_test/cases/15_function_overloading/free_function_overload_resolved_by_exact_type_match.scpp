// spec §16.3(3): in overload resolution an argument of scalar type matches
// a parameter of scalar type only if the two types are the same, so no
// implicit conversion sequence other than identity exists. f(int) and f(bool) share a name; each
// call resolves to whichever overload's parameter type exactly matches
// the argument's type.
int f(int x) {
    return x;
}

int f(bool b) {
    if (b) {
        return 100;
    }
    return 0;
}

// f(5) -> 5 (matches f(int)); f(true) -> 100 (matches f(bool)).
int g() {
    return f(5) + f(true);
}

int main() {
    return g();
}
