// Generic *type* instantiation is a distinct rule family from lambda
// synthesis and fails differently: unwalked, this reported "class 'Box'
// has no constructor matching this call", because Box<int> itself had
// never been instantiated.
template <typename T>
class Box {
  public:
    virtual ~Box() = default;
    Box(T v) : v_{v} {}
    T value() const { return v_; }
    T v_;
};
class Holder {
  public:
    virtual ~Holder() = default;
    Holder() {}
    Box<int> b_ = Box<int>{16};
};
int main() {
    Holder h{};
    return h.b_.value() - 6;
}
