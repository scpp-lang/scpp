// Likewise a generic *type* instantiated only in a member-initializer.
template <typename T>
class Box {
  public:
    virtual ~Box() = default;
    Box(T v) : v_{v} {}
    T value() const { return v_; }
    T v_;
};
class Holder {
  public:
    virtual ~Holder() = default;
    Holder() : b_{Box<int>{16}} {}
    Box<int> b_;
};
int main() {
    Holder h{};
    return h.b_.value();
}
