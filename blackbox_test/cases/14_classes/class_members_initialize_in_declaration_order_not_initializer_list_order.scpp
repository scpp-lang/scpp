// spec 6.1: members initialize in declaration order, and a field initialized
// earlier is already alive when a later field's initializer reads it. The list
// must be written in that same order, so `second` cannot be written first.

class Pair {
    public:
        virtual ~Pair() { return; }
private:
    int first;
    int second;
public:
    Pair() : first{5}, second{this->first + 1} {
        return;
    }
    int encode() const {
        return this->first * 10 + this->second;
    }
};

int main() {
    Pair p{};
    return p.encode() - 56;
}
