template<typename... Ts> class TagList;

template<>
class TagList<> {
    public:
        virtual ~TagList() = default;
    TagList() { return; }
};

template<typename Head, typename... Tail>
class TagList<Head, Tail...> : private TagList<Tail...> {
    public:
        virtual ~TagList() override = default;
    TagList() { return; }
};

consteval int take(TagList<> tags) {
    return 41;
}

consteval int answer() {
    // A named local is an lvalue and TagList has a user-declared (virtual)
    // destructor, so ch02's by-value rule needs a fresh value here -- the
    // identical runtime code has always been rejected. This body only ever
    // read `TagList<int, bool> tags{}; return take(tags);` because consteval
    // bodies were not movechecked at all. The derived-to-base conversion
    // this case is about is unchanged.
    return take(TagList<int, bool>{});
}

int main() {
    return answer();
}
