// PR #414: with no `default:` label the switch itself branches to its exit
// block for every unmatched value, so that block is reachable even though every
// listed case returns and no `break;` appears anywhere. The statements after the
// switch must therefore run for an unmatched value rather than being treated as
// dead.
int run(int selector) {
    switch (selector) {
        case 0: {
            return 1;
        }
        case 1: {
            return 2;
        }
    }
    return 3;
}

int main() {
    if (run(0) != 1) return 1;
    if (run(1) != 2) return 2;
    if (run(9) != 3) return 3;
    return 0;
}
