// ch05 §5.14: permitting same-T pass-through must not weaken the
// existing rejection of calling a method on a bare witness value.
class Num {
    public:
        virtual ~Num() { return; }
public:
    int v{};
    int doubled() {
        return this->v + this->v;
    }
};

template<typename T>
int bad(T value) {
    return passthrough(value).doubled();
}

template<typename T>
T passthrough(T value) {
    return value;
}

int main() {
    Num n{};
    n.v = 9;
    return bad(n);
}
