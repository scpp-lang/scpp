export module std:expected;

import :cstdlib;
import :concepts;

namespace std {

export template<typename E>
class unexpected {
private:
    alignas(E) char error_storage_[sizeof(E)]{};

public:
    unexpected(E error) {
        [[scpp::unsafe]] {
            new ((E*)&this->error_storage_) E(std::move(error));
        }
        return;
    }

    virtual ~unexpected() {
        [[scpp::unsafe]] {
            ((E*)&this->error_storage_)->~E();
        }
        return;
    }

    E& error() {
        [[scpp::unsafe]] {
            return ((E*)&this->error_storage_)[0];
        }
    }

    const E& error() const {
        [[scpp::unsafe]] {
            return ((const E*)&this->error_storage_)[0];
        }
    }
};

export template<typename T, typename E>
class [[nodiscard("expected results must be checked")]] expected {
private:
    bool has_value_{};
    alignas(T) alignas(E) char storage_[sizeof(T) > sizeof(E) ? sizeof(T) : sizeof(E)]{};

public:
    // [expected.object.ctor]: `constexpr expected();` is constrained on
    // `is_default_constructible_v<T>` and value-initializes the
    // contained value, leaving `has_value()` true. It was simply never
    // declared here, so `std::expected<T, E> r{};` -- ordinary C++ --
    // was reported as "type has no default constructor".
    //
    // The constraint is not decoration: scpp instantiates every method
    // of a class specialization, so an unconstrained body naming `T{}`
    // is diagnosed for every `expected<T, E>` whose `T` has no default
    // constructor -- `std::expected<Token, ParseError>` among them.
    // `std::vector`'s own `emplace_back() requires
    // std::default_initializable<T>` is the same constructor-shaped
    // member constrained on the same concept, for the same reason.
    expected() requires std::default_initializable<T> {
        this->has_value_ = true;
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T();
        }
        return;
    }

    template<typename U>
    expected(U value) {
        this->has_value_ = true;
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(std::move(value));
        }
        return;
    }

    expected(const std::unexpected<E>& error) {
        this->has_value_ = false;
        [[scpp::unsafe]] {
            new ((E*)&this->storage_) E(error.error());
        }
        return;
    }

    // [expected.object.assign]/1-4: `constexpr expected& operator=(const
    // expected& rhs)`. The wording's Constraints name four traits across
    // *both* parameters (is_copy_constructible_v<T> &&
    // is_copy_assignable_v<T> && is_copy_constructible_v<E> &&
    // is_copy_assignable_v<E>); a member's requires-clause here can name
    // one template parameter, so `T` is the one spelled. `E` is covered
    // in practice because `expected(const unexpected<E>&)` and
    // `operator=(const unexpected<E>&)` below already copy an `E`, so no
    // `expected<T, E>` with a non-copyable `E` is usable at all.
    void operator=(const std::expected<T, E>& other) requires std::copy_constructible<T> {
        this->__destroy_held();
        this->has_value_ = other.has_value();
        if (other.has_value()) {
            [[scpp::unsafe]] {
                new ((T*)&this->storage_) T(other.value());
            }
        } else {
            [[scpp::unsafe]] {
                new ((E*)&this->storage_) E(other.error());
            }
        }
        return;
    }

    // [expected.object.assign]/8-10: `template<class U> constexpr
    // expected& operator=(U&& v)` -- destroy whatever is held and
    // re-hold a value, leaving has_value() true. Split into the
    // const-lvalue and rvalue overloads `std::optional` already uses for
    // the same operator ([optional.assign]/13-15), rather than one
    // forwarding template.
    void operator=(const T& value) requires std::copy_constructible<T> {
        this->__destroy_held();
        this->has_value_ = true;
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(value);
        }
        return;
    }

    void operator=(T&& value) {
        this->__destroy_held();
        this->has_value_ = true;
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(std::move(value));
        }
        return;
    }

    // [expected.object.assign]/14-16: `template<class G> constexpr
    // expected& operator=(const unexpected<G>& e)` -- destroy whatever
    // is held and re-hold the error, leaving has_value() false.
    void operator=(const std::unexpected<E>& error) {
        this->__destroy_held();
        this->has_value_ = false;
        [[scpp::unsafe]] {
            new ((E*)&this->storage_) E(error.error());
        }
        return;
    }

    virtual ~expected() {
        this->__destroy_held();
        return;
    }



    bool has_value() const {
        return this->has_value_;
    }

    // [optional.observe]/[expected.object.obs]: `explicit operator
    // bool() const noexcept` is `has_value()`. `explicit`, so
    // `bool b = o;` remains ill-formed ([over.match.copy]/1).
    explicit operator bool() const {
        return this->has_value_;
    }

    T& value() {
        if (!this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((T*)&this->storage_)[0];
        }
    }

    const T& value() const {
        if (!this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((const T*)&this->storage_)[0];
        }
    }

    E& error() {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((E*)&this->storage_)[0];
        }
    }

    const E& error() const {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((const E*)&this->storage_)[0];
        }
    }

    // Rvalue-qualified overload: lets `std::move(x).error()` -- the
    // idiomatic way to propagate an error out of a by-value `expected`
    // that's about to go out of scope anyway (e.g. `return
    // std::unexpected(std::move(_r).error());`) -- move `E` out of
    // storage and return it fresh by value, rather than aliasing
    // storage via a reference the way the lvalue overloads above do.
    // Overload resolution (see receiver_matches_method_qualifier in
    // movecheck/calls.cppm) prefers this over the unqualified overload
    // whenever the receiver is actually an rvalue, so existing lvalue
    // call sites (`x.error()`) are unaffected.
    E error() && {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            // std::move only accepts a plain local-variable name (not an
            // arbitrary expression), so bind the storage slot to a named
            // reference first -- codegen_lvalue auto-dereferences a
            // reference local back to its referent's own address, so
            // this still moves directly out of `this->storage_` itself.
            E& source = ((E*)&this->storage_)[0];
            return std::move(source);
        }
    }

  private:
    // Called by the destructor and by every assignment operator above --
    // all of which are declared *before* it, which
    // [class.mem.general]/10.1 and /11 allow: a member function body is a
    // complete-class context, in which the class is complete, so a body
    // may name a member declared later in the class.
    void __destroy_held() {
        if (this->has_value_) {
            [[scpp::unsafe]] {
                ((T*)&this->storage_)->~T();
            }
        } else {
            [[scpp::unsafe]] {
                ((E*)&this->storage_)->~E();
            }
        }
        return;
    }
};

// A dedicated partial specialization for `expected<void, E>` --
// mirrors real C++'s standard library, which also requires its own
// `expected<void, E>` specialization: the primary template above
// stores a `T` alongside the `E` in its success/failure union, but
// `sizeof(void)`/`alignas(void)` are simply invalid, so a `void`
// success type can never share the primary's storage layout. There is
// no value to hold on success here (only the boolean discriminant),
// and `value()` becomes a no-op check-and-return rather than an
// accessor.
export template<typename E>
class [[nodiscard("expected results must be checked")]] expected<void, E> {
private:
    bool has_value_{};
    alignas(E) char storage_[sizeof(E)]{};

public:
    expected() {
        this->has_value_ = true;
        return;
    }

    expected(const std::unexpected<E>& error) {
        this->has_value_ = false;
        [[scpp::unsafe]] {
            new ((E*)&this->storage_) E(error.error());
        }
        return;
    }

    // [expected.void.assign]/1-3: the copy assignment. Unlike the
    // primary template's, this one's Constraints fall entirely on `E`
    // (there is no `T` to copy), so the clause spells exactly what the
    // wording requires.
    void operator=(const std::expected<void, E>& other) requires std::copy_constructible<E> {
        this->__destroy_held();
        this->has_value_ = other.has_value();
        if (!other.has_value()) {
            [[scpp::unsafe]] {
                new ((E*)&this->storage_) E(other.error());
            }
        }
        return;
    }

    // See the identically-motivated overload on the primary
    // `expected<T, E>` template above; [expected.void.assign]/5-7 is the
    // `expected<void, E>` wording for the same operator.
    void operator=(const std::unexpected<E>& error) {
        this->__destroy_held();
        this->has_value_ = false;
        [[scpp::unsafe]] {
            new ((E*)&this->storage_) E(error.error());
        }
        return;
    }

    virtual ~expected() {
        this->__destroy_held();
        return;
    }



    bool has_value() const {
        return this->has_value_;
    }

    // [optional.observe]/[expected.object.obs]: `explicit operator
    // bool() const noexcept` is `has_value()`. `explicit`, so
    // `bool b = o;` remains ill-formed ([over.match.copy]/1).
    explicit operator bool() const {
        return this->has_value_;
    }

    void value() const {
        if (!this->has_value_) {
            std::abort();
        }
        return;
    }

    E& error() {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((E*)&this->storage_)[0];
        }
    }

    const E& error() const {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            return ((const E*)&this->storage_)[0];
        }
    }

    // See the identically-motivated overload on the primary
    // `expected<T, E>` template above.
    E error() && {
        if (this->has_value_) {
            std::abort();
        }
        [[scpp::unsafe]] {
            E& source = ((E*)&this->storage_)[0];
            return std::move(source);
        }
    }

  private:
    // See the primary template's own helper above.
    void __destroy_held() {
        if (!this->has_value_) {
            [[scpp::unsafe]] {
                ((E*)&this->storage_)->~E();
            }
        }
        return;
    }
};

} // namespace std
