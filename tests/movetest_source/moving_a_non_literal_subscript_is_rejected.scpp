import std;

struct R {
    int id = 0;
    R(int i) : id{i} {}
    ~R() {}
};

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

struct Inner {
    R q;
    Inner(int x) : q{x} {}
};

struct Outer {
    Inner i;
    R z;
    Outer(int x, int y) : i{x}, z{y} {}
};

R make_r(int i) { R r{i}; return r; }

// Which element a runtime index names is not known statically, so there
// is no place to record the state transition against.
int caller(int i) {
    R arr[2]{make_r(1), make_r(2)};
    R t = std::move(arr[i]);
    return t.id;
}
