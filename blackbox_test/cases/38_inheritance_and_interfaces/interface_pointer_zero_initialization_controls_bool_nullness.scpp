// spec §11.2(10)-(11): a zero-initialized pointer-to-interface is null, and
// contextual conversion to `bool` depends only on that nullness.
class [[scpp::interface]] IValue {
public:
    virtual int get() const = 0;
    virtual ~IValue() = default;
};

class Box : public virtual IValue {
public:
    int value;

    Box(int v) : value{v} {}
    int get() const override {
        return value;
    }
    virtual ~Box() override = default;
};

int main() {
    IValue* p{};
    if (p) {
        return 1;
    }

    Box b{9};
    p = &b;
    if (!p) {
        return 2;
    }
    return 0;
}
