// PR #414: the braced-body rule applies to `default:` exactly as it does to
// `case`, including when `default:` is not the last label of the switch --
// label order still does not affect which label a value selects.
int classify(int selector) {
    int total = 0;
    switch (selector) {
        case 0: {
            total = 1;
            break;
        }
        default: {
            total = 2;
            break;
        }
        case 1: {
            total = 3;
            break;
        }
    }
    return total;
}

int main() {
    if (classify(0) != 1) return 1;
    if (classify(1) != 3) return 2;
    if (classify(9) != 2) return 3;
    return 0;
}
