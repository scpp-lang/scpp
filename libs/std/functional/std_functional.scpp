export template<typename R, typename... Args>
class function<R(Args...) &&> {
private:
    void* object_{};
    R (*invoke_)(void*, Args...){};
    void* (*copy_)(const void*){};
    void (*destroy_)(void*){};

public:
    template<typename F>
    function(F target) {
        [[scpp::unsafe]] {
            this->object_ = static_cast<void*>(new F(std::move(target)));
        }
        this->invoke_ = std::__move_only_function_invoke_rvalue<F, R, Args...>;
        this->copy_ = std::__function_copy<F>;
        this->destroy_ = std::__move_only_function_destroy<F>;
        return;
    }

    // [func.wrap.func.con]/8: "constructs an empty std::function" --
    // the default constructor leaves every member at its in-class
    // default member initializer (nullptr for all four), so no body is
    // needed beyond that.
    function() { return; }

    function(const std::function<R(Args...) &&>& other) {
        if (other.copy_ != nullptr) {
            this->object_ = other.copy_(other.object_);
        } else {
            this->object_ = nullptr;
        }
        this->invoke_ = other.invoke_;
        this->copy_ = other.copy_;
        this->destroy_ = other.destroy_;
        return;
    }

    std::function<R(Args...) &&>& operator=(const std::function<R(Args...) &&>& other) {
        void* copied = nullptr;
        if (other.copy_ != nullptr) {
            copied = other.copy_(other.object_);
        }
        if (this->destroy_ != nullptr) {
            [[scpp::unsafe]] {
                this->destroy_(this->object_);
            }
        }
        this->object_ = copied;
        this->invoke_ = other.invoke_;
        this->copy_ = other.copy_;
        this->destroy_ = other.destroy_;
        return *this;
    }

    // [func.wrap.func.dtor]/1: "If !*this ... no effects." `destroy_`
    // is null exactly when the wrapper is empty (default-constructed,
    // or copied/assigned from an empty one), so guarding on it rather
    // than unconditionally calling through a possibly-null function
    // pointer covers that case.
    virtual ~function() {
        if (this->destroy_ != nullptr) {
            [[scpp::unsafe]] {
                this->destroy_(this->object_);
            }
        }
        return;
    }

    // [func.wrap.func.inv]/1: "if (!*this) throws bad_function_call".
    // Exceptions are outside what this file's callers use for this
    // condition -- every real caller (src/mir.cppm's `resolve_root`,
    // src/compiler/constexpression.cppm's ModuleQuery hooks) already
    // guards a call with `if (fn)` first -- so an empty invocation is a
    // caller bug rather than a recoverable condition, exactly like
    // std::optional::value() below aborting on `!has_value_` rather
    // than throwing bad_optional_access.
    R call(Args... args) && {
        if (this->invoke_ == nullptr) std::abort();
        [[scpp::unsafe]] {
            return this->invoke_(this->object_, args...);
        }
    }

    // [func.wrap.func.general]/1 gives std::function a contextual
    // conversion to bool that is true iff `*this` has a target
    // ([func.wrap.func.con]/7's "std::function<...> f2(f); ... if
    // (f) ... " assumes exactly this). `explicit`, matching
    // std::optional's own `operator bool()` just above: `bool b = fn;`
    // stays ill-formed, only `if (fn)` and `!fn` are licensed by
    // [conv.general]/4's contextual conversion.
    explicit operator bool() const {
        return this->invoke_ != nullptr;
    }
};

export template<typename R, typename... Args>
class function<R(Args...) const &&> {
private:
    void* object_{};
    R (*invoke_)(const void*, Args...){};
    void* (*copy_)(const void*){};
    void (*destroy_)(void*){};

public:
    template<typename F>
    function(F target) {
        [[scpp::unsafe]] {
            this->object_ = static_cast<void*>(new F(std::move(target)));
        }
        this->invoke_ = std::__move_only_function_invoke_const_rvalue<F, R, Args...>;
        this->copy_ = std::__function_copy<F>;
        this->destroy_ = std::__move_only_function_destroy<F>;
        return;
    }

    // [func.wrap.func.con]/8: "constructs an empty std::function" --
    // the default constructor leaves every member at its in-class
    // default member initializer (nullptr for all four), so no body is
    // needed beyond that.
    function() { return; }

    function(const std::function<R(Args...) const &&>& other) {
        if (other.copy_ != nullptr) {
            this->object_ = other.copy_(other.object_);
        } else {
            this->object_ = nullptr;
        }
        this->invoke_ = other.invoke_;
        this->copy_ = other.copy_;
        this->destroy_ = other.destroy_;
        return;
    }

    std::function<R(Args...) const &&>& operator=(const std::function<R(Args...) const &&>& other) {
        void* copied = nullptr;
        if (other.copy_ != nullptr) {
            copied = other.copy_(other.object_);
        }
        if (this->destroy_ != nullptr) {
            [[scpp::unsafe]] {
                this->destroy_(this->object_);
            }
        }
        this->object_ = copied;
        this->invoke_ = other.invoke_;
        this->copy_ = other.copy_;
        this->destroy_ = other.destroy_;
        return *this;
    }

    // [func.wrap.func.dtor]/1: "If !*this ... no effects." `destroy_`
    // is null exactly when the wrapper is empty (default-constructed,
    // or copied/assigned from an empty one), so guarding on it rather
    // than unconditionally calling through a possibly-null function
    // pointer covers that case.
    virtual ~function() {
        if (this->destroy_ != nullptr) {
            [[scpp::unsafe]] {
                this->destroy_(this->object_);
            }
        }
        return;
    }

    // [func.wrap.func.inv]/1: "if (!*this) throws bad_function_call".
    // Exceptions are outside what this file's callers use for this
    // condition -- every real caller (src/mir.cppm's `resolve_root`,
    // src/compiler/constexpression.cppm's ModuleQuery hooks) already
    // guards a call with `if (fn)` first -- so an empty invocation is a
    // caller bug rather than a recoverable condition, exactly like
    // std::optional::value() below aborting on `!has_value_` rather
    // than throwing bad_optional_access.
    R call(Args... args) const && {
        if (this->invoke_ == nullptr) std::abort();
        [[scpp::unsafe]] {
            return this->invoke_(this->object_, args...);
        }
    }

    // [func.wrap.func.general]/1 gives std::function a contextual
    // conversion to bool that is true iff `*this` has a target
    // ([func.wrap.func.con]/7's "std::function<...> f2(f); ... if
    // (f) ... " assumes exactly this). `explicit`, matching
    // std::optional's own `operator bool()` just above: `bool b = fn;`
    // stays ill-formed, only `if (fn)` and `!fn` are licensed by
    // [conv.general]/4's contextual conversion.
    explicit operator bool() const {
        return this->invoke_ != nullptr;
    }
};

export template<typename T>
class hash;

export template<typename T>
class equal_to;

uint64_t __hash_mix_uint64(uint64_t value) {
    uint64_t mixed = value;
    [[scpp::unsafe]] {
        mixed = mixed * static_cast<uint64_t>(1099511628211);
        mixed = mixed + static_cast<uint64_t>(1469598103934665603) * 10 + 7;
    }
    return mixed;
}

uint64_t __hash_string_bytes(const std::string& value) {
    uint64_t mixed = static_cast<uint64_t>(1469598103934665603) * 10 + 7;
    uint64_t prime = static_cast<uint64_t>(1099511628211);
    const char* bytes = value.c_str();
    int index = 0;
    // spec §5.1(5.1): `bytes[index]` is raw pointer indexing. The
    // unsafe block used to cover only the mixing arithmetic below,
    // leaving the two reads that actually touch the pointer outside it.
    [[scpp::unsafe]] {
        while (bytes[index] != '\0') {
            uint64_t byte = static_cast<uint64_t>(static_cast<std::uint8_t>(bytes[index]));
            mixed = mixed + byte + 1;
            mixed = mixed * prime;
            index = index + 1;
        }
    }
    return mixed;
}

export template<>
class hash<int> {
public:
    uint64_t call(int value) const {
        return std::__hash_mix_uint64(static_cast<uint64_t>(value));
    }

    virtual ~hash() = default;
};

export template<>
class equal_to<int> {
public:
    bool call(int lhs, int rhs) const {
        return lhs == rhs;
    }

    virtual ~equal_to() = default;
};

// [unord.hash]/1 requires a `hash` specialization for every integral
// type, not only for `int`: `std::hash<size_t>` and
// `std::hash<int64_t>` are what a program spells when it mixes a
// container's own index or an identifier into a hash, and both were
// missing -- the primary template is only forward-declared above, so
// naming either was "no matching class-template definition" rather than
// a hash of the value.
//
// The return type stays `uint64_t`, the one every hasher in this
// library and every user-written one already uses (see
// unordered_map/unordered_set's own `__hash`), rather than [unord.hash]'s
// `size_t`: the two are the same 64-bit width on every target scpp
// supports, and ch06 gives no implicit conversion between two
// differently-spelled scalar type names, so changing it would silently
// reject every hasher already written against the established one.
export template<>
class hash<size_t> {
public:
    uint64_t call(size_t value) const {
        return std::__hash_mix_uint64(static_cast<uint64_t>(value));
    }

    virtual ~hash() = default;
};

export template<>
class equal_to<size_t> {
public:
    bool call(size_t lhs, size_t rhs) const {
        return lhs == rhs;
    }

    virtual ~equal_to() = default;
};

export template<>
class hash<int64_t> {
public:
    uint64_t call(int64_t value) const {
        return std::__hash_mix_uint64(static_cast<uint64_t>(value));
    }

    virtual ~hash() = default;
};

export template<>
class equal_to<int64_t> {
public:
    bool call(int64_t lhs, int64_t rhs) const {
        return lhs == rhs;
    }

    virtual ~equal_to() = default;
};

export template<>
class hash<std::string> {
public:
    uint64_t call(const std::string& value) const {
        return std::__hash_string_bytes(value);
    }

    virtual ~hash() = default;
};

export template<>
class equal_to<std::string> {
public:
    bool call(const std::string& lhs, const std::string& rhs) const {
        return lhs.equals(rhs.c_str());
    }

    virtual ~equal_to() = default;
};

} // namespace std
