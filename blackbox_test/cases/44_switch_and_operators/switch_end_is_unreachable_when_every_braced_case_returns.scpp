// PR #414: the other side of the exit-block decision. Here a `default:` label
// covers every remaining value and every case body returns, so nothing branches
// to the switch's exit block and codegen may legitimately mark it unreachable.
// That must stay true after the switch to `LLVMGetFirstUse`: the function still
// compiles and every arm still returns its own value.
int classify(int selector) {
    switch (selector) {
        case 0: {
            int base = 1;
            return base;
        }
        case 1: {
            {
                return 2;
            }
        }
        default: {
            return 3;
        }
    }
}

int main() {
    if (classify(0) != 1) return 1;
    if (classify(1) != 2) return 2;
    if (classify(6) != 3) return 3;
    return 0;
}
