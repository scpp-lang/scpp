// PR #336 plus PR #414: a label with no statements at all is not an implicit
// fallthrough -- there is nothing to fall through *from* -- so stacked labels
// sharing one body stay legal without `[[fallthrough]];`. Contrast
// `empty_braced_switch_case_body_is_rejected`: `case 1: { }` does have a
// statement (the empty block) and that block terminates nothing, so it is
// rejected.
int classify(int selector) {
    switch (selector) {
        case 0:
        case 1:
            return 10;
        default:
            return 20;
    }
}

int main() {
    if (classify(0) != 10) return 1;
    if (classify(1) != 10) return 2;
    if (classify(4) != 20) return 3;
    return 0;
}
