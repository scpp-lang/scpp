export module std:optional;

import :cstdlib;
import :concepts;

namespace std {

// [optional.nullopt]/1: "The struct nullopt_t is an empty class type
// used as a unique type to indicate the state of not containing a value
// for optional objects. In particular, optional<T> has a constructor
// with nullopt_t as a single argument; this indicates that an optional
// object not containing a value shall be constructed." /2: it "does not
// have a default constructor or an initializer-list constructor, and is
// not an aggregate" -- hence the one-argument constructor below, whose
// argument the synopsis leaves unspecified (`inline constexpr nullopt_t
// nullopt(unspecified);`).
//
// Neither the type nor the constant existed here at all, so `return
// std::nullopt;` -- what src/compiler/constexpression.cppm writes to
// leave an `optional` disengaged -- was "use of undeclared variable
// 'std::nullopt'".
export struct nullopt_t {
    explicit nullopt_t(int tag) { return; }
};

export constexpr nullopt_t nullopt{0};

export template<typename T>
class [[scpp::thread_movable_if(scpp::is_thread_movable(T), scpp::is_thread_shareable(T))]] optional {
private:
    bool has_value_{};
    alignas(T) char storage_[sizeof(T)]{};

    // [optional.ctor]/23.1, /28.1 and [optional.assign]/14.3 all state
    // the same Constraints: `is_constructible_v<T, ...>`. A `T` that
    // cannot be copied therefore *removes* the copying members from
    // overload resolution; it does not make `optional<T>` itself
    // ill-formed. Unconstrained, and because scpp instantiates every
    // member of a class specialization, these bodies were diagnosed for
    // every `optional<T>` with a non-copyable `T` -- including
    // `std::optional<std::expected<T, E>>`, which
    // src/compiler/constexpression.cppm returns. Same clause, same
    // concept and same fix as `std::vector`'s own `vector(const
    // std::vector<T>&) requires std::copy_constructible<T>`.
    void __construct_value(const T& value) requires std::copy_constructible<T> {
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(value);
        }
        this->has_value_ = true;
        return;
    }

    void __construct_value(T&& value) {
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(std::move(value));
        }
        this->has_value_ = true;
        return;
    }

    // [optional.ctor]/24 and [optional.assign]/15 both say what the
    // value-taking members do with a `U`: "direct-non-list-initializes
    // val with std::forward<U>(v)". One place, since the constructor and
    // the assignment ask the identical question and must not drift.
    template<typename U>
    void __construct_converted(U value) {
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(std::move(value));
        }
        this->has_value_ = true;
        return;
    }

    void __copy_from(const std::optional<T>& other) requires std::copy_constructible<T> {
        if (!other.has_value()) {
            this->has_value_ = false;
            return;
        }
        [[scpp::unsafe]] {
            new ((T*)&this->storage_) T(*other);
        }
        this->has_value_ = true;
        return;
    }

public:
    optional() { return; }

    // [optional.ctor]/2-3: `constexpr optional(nullopt_t) noexcept` --
    // "Postconditions: *this does not contain a value. Remarks: No
    // contained value is initialized."
    optional(nullopt_t null_option) { return; }

    optional(const T& value) requires std::copy_constructible<T> {
        this->__construct_value(value);
        return;
    }

    optional(T&& value) {
        this->__construct_value(std::move(value));
        return;
    }

    // [optional.ctor]/23-24: the value-taking constructor is
    // `template<class U = remove_cv_t<T>> constexpr explicit(see below)
    // optional(U&& v)`, constrained on `is_constructible_v<T, U>`, whose
    // effect is to direct-initialize the contained `T` from the `U`. It
    // was declared here on the concrete `T` alone, so a `U` that is not
    // spelled `T` had to reach the contained object through a *second*
    // user-defined conversion -- the argument of a user-defined
    // conversion, which [over.best.ics]/4 restricts to standard
    // conversion sequences. `std::optional<std::expected<T, E>> f() {
    // return std::unexpected(e); }` is ordinary C++ for that reason and
    // for no other: real `std::optional` deduces `U = std::unexpected<E>`
    // and performs the `expected` construction *inside* the constructor,
    // where it is a direct-initialization and not part of any conversion
    // sequence. A hand-written class declaring only `Opt(const T&)` and
    // `Opt(T&&)` is rejected by clang++-22 -std=c++26 on the identical
    // program, which is what this member was.
    //
    // Deliberately the same shape `std::expected`'s own
    // `template<typename U> expected(U value)` already has for
    // [expected.object.ctor]'s identical requirement -- the two
    // `T`-spelled overloads above stay because they are the `U = T` case
    // that [over.match.best]/2.5 prefers anyway, and because only they
    // can take a `const T&` borrow: an `optional<T>` built from a named
    // lvalue must not start requiring `T` to be movable.
    template<typename U>
    optional(U value) {
        this->__construct_converted(std::move(value));
        return;
    }

    optional(const std::optional<T>& other) requires std::copy_constructible<T> {
        this->__copy_from(other);
        return;
    }

    // [optional.assign]/1-3: `constexpr optional<T>& operator=(nullopt_t)
    // noexcept` -- "If *this contains a value, calls val.T::~T() to
    // destroy the contained value; otherwise no effect", which is
    // exactly `reset()` below.
    void operator=(nullopt_t null_option) {
        this->reset();
        return;
    }

    void operator=(const T& value) requires std::copy_constructible<T> {
        this->reset();
        this->__construct_value(value);
        return;
    }

    void operator=(T&& value) {
        this->reset();
        this->__construct_value(std::move(value));
        return;
    }

    void operator=(const std::optional<T>& other) requires std::copy_constructible<T> {
        this->reset();
        this->__copy_from(other);
        return;
    }

    virtual ~optional() {
        this->reset();
        return;
    }

    bool has_value() const {
        return this->has_value_;
    }

    // [optional.observe]/[expected.object.obs]: `explicit operator
    // bool() const noexcept` is `has_value()`. `explicit`, so
    // `bool b = o;` remains ill-formed ([over.match.copy]/1).
    explicit operator bool() const {
        return this->has_value_;
    }

    T& value() {
        if (!this->has_value_) std::abort();
        [[scpp::unsafe]] {
            return ((T*)&this->storage_)[0];
        }
    }

    const T& value() const {
        if (!this->has_value_) std::abort();
        [[scpp::unsafe]] {
            return ((const T*)&this->storage_)[0];
        }
    }

    T& operator*() {
        [[scpp::unsafe]] {
            return ((T*)&this->storage_)[0];
        }
    }

    const T& operator*() const {
        [[scpp::unsafe]] {
            return ((const T*)&this->storage_)[0];
        }
    }

    T* operator->() [[scpp::lifetime(self)]] {
        [[scpp::unsafe]] {
            return (T*)&this->storage_;
        }
    }

    const T* operator->() const [[scpp::lifetime(self)]] {
        [[scpp::unsafe]] {
            return (const T*)&this->storage_;
        }
    }

    // [optional.nullops]/1: `operator==(const optional<T>& x, nullopt_t)`
    // returns `!x.has_value()`. Spelled as members, the way this
    // codebase's other comparable types (std::string_view,
    // std::unique_ptr) spell theirs; `operator!=` alongside for the same
    // reason they declare both.
    bool operator==(nullopt_t null_option) const {
        return !this->has_value_;
    }

    bool operator!=(nullopt_t null_option) const {
        return this->has_value_;
    }

    void reset() {
        if (!this->has_value_) return;
        [[scpp::unsafe]] {
            ((T*)&this->storage_)->~T();
        }
        this->has_value_ = false;
        return;
    }

};

} // namespace std
