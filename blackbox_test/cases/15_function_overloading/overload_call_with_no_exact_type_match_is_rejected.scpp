// spec §16.3(3) and its note: scalar matching is exact, and a call cannot
// be ambiguous by reason of a conversion between scalar types -- so a
// non-matching argument leaves zero viable candidates rather than
// silently converting. `char` matches
// neither f(int) nor f(bool) exactly, so the call is rejected rather than
// silently converting.
int f(int x) {
    return x;
}

int f(bool b) {
    return 1;
}

int g() {
    char c = 'a';
    return f(c);
}

int main() {
    return g();
}
