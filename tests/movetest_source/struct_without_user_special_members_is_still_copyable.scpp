// The control for struct_with_a_user_destructor_is_not_copy_assignable:
// spec §6.5(2)/(3) suppress the implicit copy operations only when the
// type declares a destructor, a copy constructor or a copy assignment
// operator. A plain aggregate declares none, so it keeps both -- making
// §6.5 apply to structs must not make every struct non-copyable.
import std;

struct S {
    int v;
};

int main() {
    S a{};
    S b{};
    a = b;
    S c = a;
    return c.v;
}
