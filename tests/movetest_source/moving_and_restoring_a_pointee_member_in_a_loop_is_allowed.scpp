// The control for the loop back edge: restoring the place before the back
// edge makes the merged state initialized again, so the next iteration's
// move is well-formed.
import std;

struct R {
    int id = 0;
    R() {}
    R(int i) : id{i} {}
    ~R() { return; }
};

R mk(int i) { R r{}; r.id = i; return r; }

struct S {
    R a;
    R b;
    S() : a{0}, b{0} {}
    S(int x, int y) : a{x}, b{y} {}
};

int main() {
    std::unique_ptr<S> u = std::make_unique<S>();
    u->a.id = 1;
    for (int i = 0; i < 2; i = i + 1) { R t = std::move(u->a); u->a = mk(i); }
    return u->a.id;
}
