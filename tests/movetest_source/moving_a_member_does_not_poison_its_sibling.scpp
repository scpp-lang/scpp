import std;

struct R {
    int id = 0;
    R(int i) : id{i} {}
    ~R() {}
};

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

struct Inner {
    R q;
    Inner(int x) : q{x} {}
};

struct Outer {
    Inner i;
    R z;
    Outer(int x, int y) : i{x}, z{y} {}
};

R make_r(int i) { R r{i}; return r; }

// Per-place granularity: moving `s.a` must leave `s.b` initialized.
// The LocalId-keyed model could not express this at all.
int caller() {
    S s{1, 2};
    R t = std::move(s.a);
    int v = s.b.id;
    s.a = make_r(9);
    return v + t.id;
}
