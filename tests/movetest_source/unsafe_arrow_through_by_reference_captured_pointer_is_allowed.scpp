// ch03 §7.2: `E1->E2` on a raw pointer is well-formed only in an unsafe
// context. Same reference-to-pointer capture field as the `*p` case.
class K {
public:
    virtual ~K() { return; }
    int v{7};
};

int main() {
    K k{};
    K* p = &k;
    auto reader = [&p]() {
        int v = 0;
        [[scpp::unsafe]] {
            v = p->v;
        }
        return v;
    };
    return reader();
}
