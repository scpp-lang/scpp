// spec §6: `x += 1`'s type is the type of the place being written,
// whatever the right-hand side spells -- the untyped-literal rule for
// plain arithmetic must not be extended to the assignment forms.
int f() {
    size_t total = 0;
    total += 1;
    total -= 1;
    total *= 2;
    if (total == 0) { return 1; }
    return 0;
}
