export module std:functional;

import :string;
import :cstdlib;

namespace std {

template<typename F>
void __move_only_function_destroy(void* erased) {
    [[scpp::unsafe]] {
        F* typed = static_cast<F*>(erased);
        delete typed;
    }
    return;
}

template<typename F>
void* __function_copy(const void* erased) {
    [[scpp::unsafe]] {
        const F* typed = static_cast<const F*>(erased);
        const F& source = *typed;
        return static_cast<void*>(new F(source));
    }
}

template<typename F, typename R, typename... Args>
R __move_only_function_invoke(void* erased, Args... args) {
    [[scpp::unsafe]] {
        F* typed = static_cast<F*>(erased);
        return typed->call(args...);
    }
}

template<typename F, typename R, typename... Args>
R __move_only_function_invoke_const(const void* erased, Args... args) {
    [[scpp::unsafe]] {
        const F* typed = static_cast<const F*>(erased);
        return typed->call(args...);
    }
}

template<typename F, typename R, typename... Args>
R __move_only_function_invoke_rvalue(void* erased, Args... args) {
    [[scpp::unsafe]] {
        F* typed = static_cast<F*>(erased);
        F& callable = *typed;
        return std::move(callable).call(args...);
    }
}

template<typename F, typename R, typename... Args>
R __move_only_function_invoke_const_rvalue(const void* erased, Args... args) {
    [[scpp::unsafe]] {
        const F* typed = static_cast<const F*>(erased);
        const F& callable = *typed;
        return std::move(callable).call(args...);
    }
}

export template<typename Sig>
class move_only_function;

export template<typename Sig>
class function;

export template<typename T>
class reference_wrapper {
private:
    T* ptr_{};

public:
    reference_wrapper(T& value) : ptr_{&value} { return; }
    reference_wrapper(const reference_wrapper&) = default;
    reference_wrapper& operator=(const reference_wrapper&) = default;

    // Intentionally omits an implicit `operator T&()` until conversion operators are supported.
    // [refwrap.access]: `constexpr T& get() const noexcept;` -- one
    // accessor, const-qualified, returning a non-const `T&`. A
    // reference_wrapper is a view; its own constness never reaches the
    // referent.
    T& get() const {
        [[scpp::unsafe]] {
            return *this->ptr_;
        }
    }

    virtual ~reference_wrapper() { return; }
};

export template<typename R, typename... Args>
class move_only_function<R(Args...)> {
private:
    void* object_{};
    R (*invoke_)(void*, Args...){};
    void (*destroy_)(void*){};

public:
    template<typename F>
    move_only_function(F target) {
        [[scpp::unsafe]] {
            this->object_ = static_cast<void*>(new F(std::move(target)));
        }
        this->invoke_ = std::__move_only_function_invoke<F, R, Args...>;
        this->destroy_ = std::__move_only_function_destroy<F>;
        return;
    }

    virtual ~move_only_function() {
        [[scpp::unsafe]] {
            this->destroy_(this->object_);
        }
        return;
    }

    R call(Args... args) {
        [[scpp::unsafe]] {
            return this->invoke_(this->object_, args...);
        }
    }
};

