import std;

struct R {
    int id = 0;
    R(int i) : id{i} {}
    ~R() {}
};

struct S {
    R a;
    R b;
    S(int x, int y) : a{x}, b{y} {}
};

struct Inner {
    R q;
    Inner(int x) : q{x} {}
};

struct Outer {
    Inner i;
    R z;
    Outer(int x, int y) : i{x}, z{y} {}
};

R make_r(int i) { R r{i}; return r; }

// Which element a runtime index names is not known statically, so there
// is no place to record the state transition against -- and that is an
// answer, not a rejection. spec ch02 §6.2(3) attaches the transition to
// `E` being an *id-expression*; it does not require `E` to be one, and
// §6.2's note says outright that moving a subobject out "is not yet
// specified by this document", which by front-matter §1(2) leaves the
// C++ rule applying unchanged. §6.2(2) then leaves every element in the
// initialized state and §6.3(1) invokes each destructor -- which is
// exactly what C++ does with a moved-from object. This case used to
// resolve the divergence by rejecting.
int caller(int i) {
    R arr[2]{make_r(1), make_r(2)};
    R t = std::move(arr[i]);
    return t.id;
}

int main() { return caller(0) == 1 ? 0 : 1; }
