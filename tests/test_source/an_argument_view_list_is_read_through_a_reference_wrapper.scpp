// ch01 §5.1(5.1) makes "indirection through, or pointer arithmetic on, a
// value of pointer type" a gated operation, and ch03 §7.1(4) restates it
// for `*E`: "An expression of the form `*E`, where `E` is of pointer
// type, remains governed by [expr.unary.op] and by this document's
// existing requirements on pointer dereference, including §5.1(5.1) and
// (6)." A list of `const T*` therefore cannot be read at all in a safe
// context -- `*list[i]` is exactly that indirection.
//
// src/compiler/constexpression.cppm's own header comment already states
// the model this file exercises: "scpp has no nullable-reference type and
// rejects dereferencing a raw pointer outside `[[scpp::unsafe]] { }`
// (ch01 §1.3/ch02), so every 'found it, or didn't' lookup below returns
// an optional reference instead of a raw `T*`." Its argument-view lists
// were the positions that had not been converted, and
// call_with_expr_arg_views' `const Expr& arg_expr = *args[i];` is what
// the self-hosting probe stopped on.
//
// This pins that the reference-view model works in every position that
// file needs: as a vector element, read at top level, read inside a
// lambda that captures the list by reference, and passed on by const
// reference. The compiler's own rules are unchanged by that migration, so
// this program compiles both before and after it -- it exists so a later
// change cannot quietly take the model away.
//
// The same program transliterated to C++ and built with
// clang++-22 -std=c++26 prints the same five lines.
import std;

class Node {
public:
    int v;

    Node() : v{0} { return; }
    virtual ~Node() { return; }
};

using NodeView = std::reference_wrapper<const Node>;

[[nodiscard]] NodeView make_node_view(const Node& node) {
    return std::reference_wrapper<const Node>{node};
}

int sum_at_top_level(const std::vector<NodeView>& views) {
    int total = 0;
    for (std::size_t i = 0; i < views.size(); ++i) {
        const Node& node = views[i].get();
        total = total + node.v;
    }
    return total;
}

int sum_inside_a_lambda(const std::vector<NodeView>& views) {
    auto body = [&]() -> int {
        int total = 0;
        for (std::size_t i = 0; i < views.size(); ++i) {
            const Node& node = views[i].get();
            total = total + node.v;
        }
        return total;
    };
    return body();
}

int forwarded(const std::vector<NodeView>& views) {
    return sum_at_top_level(views);
}

int main() {
    std::unique_ptr<Node> owned = std::make_unique<Node>();
    owned->v = 7;
    Node local{};
    local.v = 5;

    std::vector<NodeView> views{};
    views.reserve(2);
    // Built from an owning handle and from a plain local alike, which is
    // exactly the two shapes call_with_expr_args and the immediate-call
    // path assemble.
    views.push_back(make_node_view(*owned));
    views.push_back(make_node_view(local));

    std::print("count {}\n", static_cast<int>(views.size()));
    std::print("first {}\n", views[0].get().v);
    std::print("top_level {}\n", sum_at_top_level(views));
    std::print("in_lambda {}\n", sum_inside_a_lambda(views));
    std::print("forwarded {}\n", forwarded(views));
    return 0;
}
